# Yalla Control Plane production environment example.
# Install the rendered copy as /etc/yalla/control-plane.env with owner
# root:yalla and mode 0640. Replace every <redacted:...> placeholder from the
# operator secret manager. Never commit the rendered file or paste values into
# logs, tickets, audit metadata, or dry-run output.
#
# This file is consumed by both production backend binaries:
#   /usr/local/bin/yalla-api
#   /usr/local/bin/yalla-worker
#
# API operators verify process health through GET /healthz and dependency
# readiness through GET /readyz. Responses use yalla.output.v1 or
# yalla.error.v1 envelopes. Both binaries write structured JSON diagnostics;
# logs must not contain rendered environment values or secrets.

YALLA_PROFILE=production
YALLA_API_ADDR=127.0.0.1:8080
YALLA_PUBLIC_URL=https://api.example.com

# Source-of-truth Postgres DSN. Use a least-privilege role for the deployed
# API and worker processes.
YALLA_DATABASE_URL=<redacted:postgres-dsn>

# Signing keys are comma-separated. The first entry signs new tokens; later
# entries are accepted during rotation.
YALLA_SIGNING_KEYS=<redacted:signing-keys>

# Secret keys are comma-separated 64-character hex AES-256 keys. The first
# entry seals new encrypted values; later entries are accepted during rotation.
YALLA_SECRET_KEYS=<redacted:secret-keys>

# Private Dokploy endpoint and privileged worker token. Customers must never
# receive this token and must never call Dokploy directly.
YALLA_DOKPLOY_BASE_URL=https://dokploy.internal.example.com
YALLA_DOKPLOY_TOKEN=<redacted:dokploy-token>

# Shared internal worker callback token. Configure the exact same value for
# yalla-api and yalla-worker.
YALLA_INTERNAL_WORKER_TOKEN=<redacted:internal-worker-token>

# Optional backup freshness probe inputs for GET /healthz/backup.
YALLA_BACKUP_STATUS_FILE=/var/lib/yalla/backup.status
YALLA_BACKUP_MAX_AGE=26h

# Structured diagnostics and graceful shutdown.
YALLA_LOG_LEVEL=info
YALLA_SHUTDOWN_TIMEOUT=30s

# Optional inbound rate-limit tuning. Leave unset to use production defaults.
YALLA_RATE_LIMIT_BACKEND=redis
YALLA_RATE_LIMIT_REDIS_URL=<redacted:redis-dsn>
YALLA_RATE_LIMIT_REDIS_KEY_PREFIX=yalla:control-plane:ratelimit
YALLA_RATE_LIMIT_REDIS_TIMEOUT=250ms
# YALLA_RATE_LIMIT_ORG_READ_RPS=100
# YALLA_RATE_LIMIT_ORG_READ_BURST=200
# YALLA_RATE_LIMIT_ORG_WRITE_RPS=30
# YALLA_RATE_LIMIT_ORG_WRITE_BURST=60
# YALLA_RATE_LIMIT_KEY_READ_RPS=50
# YALLA_RATE_LIMIT_KEY_READ_BURST=100
# YALLA_RATE_LIMIT_KEY_WRITE_RPS=15
# YALLA_RATE_LIMIT_KEY_WRITE_BURST=30
# YALLA_RATE_LIMIT_IP_READ_RPS=60
# YALLA_RATE_LIMIT_IP_READ_BURST=120
# YALLA_RATE_LIMIT_IP_WRITE_RPS=20
# YALLA_RATE_LIMIT_IP_WRITE_BURST=40
# YALLA_RATE_LIMIT_IDLE_TTL=5m
