{
  "organization": "acme-corp-org-0000000000000000000000000a",
  "project": "storefront-proj-0000000000000000000000000b",
  "environment": "production-env-0000000000000000000000000c",
  "tier": "production",
  "service": {
    "name": "api-svc-0000000000000000000000000d",
    "type": "application",
    "role": "web",
    "resources": {
      "cpu_millis": 1000,
      "memory_mib": 1024,
      "replicas": 2
    },
    "build": {
      "builder": "image",
      "image": "registry.example/api:v1.2.3"
    },
    "domains": [
      {
        "host": "api.acme.example",
        "https": true,
        "path": "/"
      }
    ],
    "labels": [
      {
        "key": "yalla.environment",
        "value": "env_0000000000000000000000000c"
      },
      {
        "key": "yalla.managed-by",
        "value": "yalla-control-plane"
      },
      {
        "key": "yalla.organization",
        "value": "org_0000000000000000000000000a"
      },
      {
        "key": "yalla.project",
        "value": "proj_0000000000000000000000000b"
      },
      {
        "key": "yalla.role",
        "value": "web"
      },
      {
        "key": "yalla.service",
        "value": "svc_0000000000000000000000000d"
      },
      {
        "key": "yalla.service-type",
        "value": "application"
      },
      {
        "key": "yalla.tier",
        "value": "production"
      }
    ],
    "variables": [
      {
        "name": "API_TOKEN",
        "value": "[REDACTED]",
        "secret": true,
        "source": "service"
      },
      {
        "name": "FEATURE_X",
        "value": "[REDACTED]",
        "secret": false,
        "source": "service"
      },
      {
        "name": "LOG_LEVEL",
        "value": "[REDACTED]",
        "secret": false,
        "source": "environment"
      },
      {
        "name": "REGION",
        "value": "[REDACTED]",
        "secret": false,
        "source": "organization"
      }
    ]
  }
}