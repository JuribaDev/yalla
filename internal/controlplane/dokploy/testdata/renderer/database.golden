{
  "organization": "acme-corp-org-0000000000000000000000000a",
  "project": "storefront-proj-0000000000000000000000000b",
  "environment": "staging-env-0000000000000000000000000c",
  "tier": "staging",
  "service": {
    "name": "primary-database-svc-0000000000000000000000000d",
    "type": "database",
    "engine": "postgres",
    "resources": {
      "cpu_millis": 500,
      "memory_mib": 512,
      "replicas": 1
    },
    "build": {
      "builder": "dockerfile",
      "dockerfile_path": "Dockerfile",
      "git_branch": "main"
    },
    "domains": null,
    "labels": [
      {
        "key": "yalla.engine",
        "value": "postgres"
      },
      {
        "key": "yalla.environment",
        "value": "env_0000000000000000000000000c"
      },
      {
        "key": "yalla.managed-by",
        "value": "yalla-control-plane"
      },
      {
        "key": "yalla.organization",
        "value": "org_0000000000000000000000000a"
      },
      {
        "key": "yalla.project",
        "value": "proj_0000000000000000000000000b"
      },
      {
        "key": "yalla.service",
        "value": "svc_0000000000000000000000000d"
      },
      {
        "key": "yalla.service-type",
        "value": "database"
      },
      {
        "key": "yalla.tier",
        "value": "staging"
      }
    ],
    "variables": [
      {
        "name": "API_TOKEN",
        "value": "[REDACTED]",
        "secret": true,
        "source": "service"
      },
      {
        "name": "FEATURE_X",
        "value": "[REDACTED]",
        "secret": false,
        "source": "service"
      },
      {
        "name": "LOG_LEVEL",
        "value": "[REDACTED]",
        "secret": false,
        "source": "environment"
      },
      {
        "name": "REGION",
        "value": "[REDACTED]",
        "secret": false,
        "source": "organization"
      }
    ]
  }
}