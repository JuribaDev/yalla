+				"pg_dump --format=custom --no-acl --no-owner --compress=9",
+				"/usr/local/bin/yalla-api",
+				"/usr/local/bin/yalla-worker",
+				"/healthz",
+				"/readyz",
+				"/healthz/backup",
+				"yalla.output.v1",
+				"yalla.error.v1",
+				"structured JSON",
+			},
+		},
+		{
+			path: "scripts/verify.sh",
+			want: []string{
+				"go test ./internal/release/... -run TestBackupCommand",
+			},
+		},
+		{
+			path: ".github/workflows/ci.yml",
+			want: []string{
