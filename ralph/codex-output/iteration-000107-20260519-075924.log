+	mu     sync.Mutex
+	total  int64
+	series map[jobQueueMetricKey]*jobQueueMetricSeries
+}
+
+type jobQueueMetricKey struct {
+	event       JobQueueEventName
+	jobType     string
+	status      string
+	statusClass string
+}
+
+type jobQueueMetricSeries struct {
+	JobQueueMetric
+}
