+
+func findJobQueueMetric(metrics []JobQueueMetric, event JobQueueEventName, jobType, status string) *JobQueueMetric {
+	for i := range metrics {
+		if metrics[i].Event == event && metrics[i].JobType == jobType && metrics[i].Status == status {
+			return &metrics[i]
+		}
+	}
+	return nil
+}
