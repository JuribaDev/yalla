+	Event          JobQueueEventName
+	JobType        string
+	Status         string
+	StatusClass    string
+	JobID          string
+	RequestID      string
+	CorrelationID  string
+	OrganizationID string
+	ProjectID      string
+	EnvironmentID  string
+	ServiceID      string
