+		OrganizationID: job.OrganizationID,
+		ProjectID:      job.ProjectID,
+		EnvironmentID:  job.EnvironmentID,
+		ServiceID:      job.ServiceID,
+		Attempt:        job.Attempts,
+		MaxAttempts:    job.MaxAttempts,
+		NextRunDelayMS: nextRunDelay.Milliseconds(),
+	}
