+func (c *StoreClaimer) recordClaimMetric(job store.ProvisioningJob) {
+	if c == nil || c.metrics == nil {
+		return
+	}
+	c.metrics.RecordJobQueueEvent(jobQueueEvent(job, telemetry.JobQueueEventClaimed, job.Status, 0))
+}
