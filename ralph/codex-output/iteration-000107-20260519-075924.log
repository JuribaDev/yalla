+		status:      event.Status,
+		statusClass: event.StatusClass,
+	}
+
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	m.total++
+	series := m.series[key]
+	if series == nil {
+		series = &jobQueueMetricSeries{JobQueueMetric: JobQueueMetric{
+			Event:       event.Event,
+			JobType:     event.JobType,
+			Status:      event.Status,
+			StatusClass: event.StatusClass,
+		}}
