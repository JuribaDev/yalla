+	Event          JobQueueEventName
+	JobType        string
+	Status         string
+	StatusClass    string
+	JobID          string
+	RequestID      string
+	CorrelationID  string
+	OrganizationID string
+	ProjectID      string
+	EnvironmentID  string
+	ServiceID      string
+	Attempt        int
+	MaxAttempts    int
+	NextRunDelayMS int64
+}
+
+// JobQueueMetric is one aggregate durable-job queue series.
