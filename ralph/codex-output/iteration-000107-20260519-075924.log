+		ServiceID:      "svc_queue_metrics",
+		JobType:        "sync_variables",
+		Status:         store.JobStatusRunning,
+		Attempts:       2,
+		MaxAttempts:    5,
+		RequestID:      "req_queue_metrics",
+		CorrelationID:  "corr_queue_metrics",
+	}
