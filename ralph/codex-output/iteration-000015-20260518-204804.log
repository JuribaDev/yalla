diff --git a/internal/controlplane/store/deployment_state_machine_test.go b/internal/controlplane/store/deployment_state_machine_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..dbd02235ae4cb87bbe90bb6f43896f1ad07d0a13
--- /dev/null
