+			for _, candidate := range allowed[from] {
+				if candidate == to {
+					want = true
+					break
+				}
+			}
+			if got := from.CanTransitionTo(to); got != want {
+				t.Errorf("%s.CanTransitionTo(%s) = %v, want %v", from, to, got, want)
