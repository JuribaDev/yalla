    "boundaries": [
      "cmd/yalla is the CLI binary and should depend on internal/cli plus a control-plane HTTP client when customer workflows move to the backend.",
      "cmd/yalla-api is the backend HTTP API binary and depends on internal/controlplane packages.",
      "cmd/yalla-worker is the backend worker binary and depends on internal/controlplane worker/job/provisioning packages.",
      "internal/cli owns Cobra commands, terminal UX, local config, and CLI output behavior.",
      "internal/controlplane owns backend API handlers, auth, policy, quota, jobs, persistence, metering, billing, audit, and provisioning orchestration.",
      "internal/api and internal/dokploy are shared low-level Dokploy integration packages used behind explicit boundaries.",
      "The CLI must not import internal/controlplane/store, policy, quota, jobs, or worker packages directly for customer workflows; it should call the control-plane API through an HTTP client.",
      "If a reusable external Go SDK is needed later, create pkg/yallaapi or a generated client package rather than exporting backend internals."
    ],
    "futureClientPackage": {
      "internalFirst": "internal/controlplane/client for repo-local CLI-to-control-plane calls",
      "publicLater": "pkg/yallaapi only if external Go consumers need a supported SDK"
    }
  }
}
{
  "language": "Go 1.24+",
  "http": "net/http, chi-compatible router, middleware chain, typed handlers",
  "database": "PostgreSQL, pgx, migrations with goose or atlas, optional sqlc for typed queries",
  "queue": "Postgres-backed jobs; no Redis dependency required for v1 backend",
  "auth": "Hashed API keys, service accounts, session/JWT verifier, scoped grants, RBAC policy engine",
  "secrets": "Envelope encryption abstraction for secret variables and Dokploy service token handling",
  "observability": "Structured JSON logs, Prometheus metrics, OpenTelemetry traces, request IDs, audit events",
  "tests": [
    "go test ./...",
    "go test -race ./...",
    "go vet ./...",
    "migration tests",
    "httptest contract tests",
    "Postgres integration tests",
    "fake Dokploy worker tests",
    "policy matrix tests",
    "quota concurrency tests",
    "fuzz tests",
    "optional live-Dokploy smoke tests"
  ],
  "release": [
    "API binary",
    "worker binary",
    "Docker images",
    "migration command",
    "local docker-compose stack",
    "deployment runbooks"
  ],
  "metering": "Traefik metrics for HTTP traffic, Prometheus-compatible time-series storage for raw metrics, Yalla usage_events and usage_counters for billing-grade aggregation",
  "billing": "Internal billing provider abstraction; Stripe/manual invoicing adapters can be added without changing entitlement or usage models"
}
