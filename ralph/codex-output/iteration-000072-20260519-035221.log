{
  "goal": "The backoffice is the operational control surface for plans, entitlements, subscriptions, metering sources, usage aggregation, billing exports, quota policies, feature flags, and enforcement modes. Backend services read effective configuration from Postgres-backed admin state with safe caching and audit logs.",
  "configurableResources": [
    "plan catalog",
    "plan entitlement keys and values",
    "organization subscription status and billing period",
    "organization entitlement overrides and add-ons",
    "quota hard/soft/metered enforcement modes",
    "usage metric definitions and units",
    "metering source configuration for Traefik, Prometheus, Dokploy, cAdvisor, Docker stats, volume scanners, and backup metadata",
    "metric attribution rules and quarantine policy",
    "usage aggregation schedules and period close rules",
    "billing provider adapters and export settings",
    "warning thresholds and upgrade hints",
    "overage policy per entitlement key",
    "trial rules and grace periods",
    "feature flags by plan, organization, project, environment, or service",
    "admin/break-glass roles and support access policy",
    "audit retention and export policy"
  ],
  "safetyRules": [
    "Every backoffice mutation requires admin authorization and is audited with before/after diffs.",
    "Backoffice changes support dry-run validation before publish.",
    "Dangerous changes can be scheduled for a future effective_at timestamp.",
    "Published changes create immutable versions so invoices and historical usage can be reproduced.",
    "Secrets in metering source or billing provider config are write-only and encrypted at rest.",
    "Backoffice APIs must support rollback to a previous published version where safe."
  ],
  "diagrams": {
    "backofficeFlow": "flowchart TD\n  Admin[\"Backoffice admin\"] --> API[\"Admin API\"]\n  API --> Policy[\"Admin policy + break-glass checks\"]\n  Policy --> Draft[\"Draft config version\"]\n  Draft --> Validate[\"Dry-run validation\"]\n  Validate --> Publish[\"Publish effective config\"]\n  Publish --> Audit[(\"Audit log\")]\n  Publish --> Cache[\"Config cache invalidation\"]\n  Cache --> Runtime[\"API / worker / aggregator runtime\"]",
    "configResolution": "flowchart LR\n  Defaults[\"Safe built-in defaults\"] --> Seeds[\"Migration seed config\"]\n  Seeds --> Backoffice[\"Published backoffice config\"]\n  Backoffice --> Overrides[\"Org/subscription overrides\"]\n  Overrides --> Effective[\"Effective runtime config\"]\n  Effective --> API[\"API enforcement\"]\n  Effective --> Worker[\"Worker provisioning\"]\n  Effective --> Metering[\"Usage aggregation\"]\n  Effective --> Billing[\"Billing export\"]"
  }
}

