codex/yalla-control-plane-backend
Build the production-grade backend API layer between customers and Dokploy. Yalla Control Plane is the source of truth for tenants, ownership, policy, limits, desired state, audit, and provisioning jobs; Dokploy is the private execution engine used for infrastructure provisioning.
{
  "path": "/Users/juribadev/projects/poc/dokploy/openapi.json",
  "openapi": "3.1.0",
  "title": "Dokploy API",
  "version": "1.0.0",
  "sha256": "6123f5d874d169f83ffdcc8b821fc848c96095084aa5b9a68eb8e94759d8fed2",
  "pathCount": 455,
  "operationCount": 455,
  "role": "Private provisioning backend only; customers must not call this API directly."
}
[
  "The CLI, control-plane API, and worker live in the same Go repository as separate binaries so shared contracts do not drift.",
  "Yalla Control Plane is the source of truth; Dokploy is the provisioning engine.",
  "Customers, agents, and CI must never receive broad Dokploy API keys.",
  "The backend mirrors Dokploy hierarchy: Organization -> Project -> Environment -> Service.",
  "Authorization, ownership, limits, audit, and desired state are enforced before any Dokploy operation.",
  "Expose intent-based Yalla APIs, not a customer-facing generic Dokploy proxy.",
  "Dokploy permissions may be configured as defense-in-depth, but Yalla policy is authoritative.",
  "Every public API response, error code, audit event, and state transition is a compatibility contract.",
  "No MVP shortcuts. The backend must include migrations, tests, observability, security controls, and operational runbooks.",
  "Pricing is enforced through plan entitlements, quotas, and billing-grade usage counters, not through frontend-only package text.",
  "Traffic and infrastructure metering must be owned by Yalla; Dokploy monitoring is useful operational input but not the billing source of truth.",
  "Current resource state is used for real-time quota enforcement; append-only usage events and period counters are used for billing and growth tracking.",
  "All pricing, entitlement, metering, usage aggregation, billing export, quota, and enforcement settings must be configurable from the backoffice/admin API with audit trails.",
  "Runtime pricing and metering behavior must come from database-backed configuration, not hardcoded constants, except for safe built-in defaults and migration seeds."
]
{
  "language": "Go",
  "apiFramework": "net/http with chi-style routing; keep handlers thin and logic in internal/controlplane packages",
  "database": "PostgreSQL via pgx; migrations through goose or atlas; SQL must be tenant-scoped and testable",
  "queue": "Postgres-backed durable jobs, preferably river or a small SKIP LOCKED implementation",
  "dokploy": "Typed Dokploy provisioning client behind internal/controlplane/dokploy; never exposed to customers as raw proxy",
  "diagrams": {
    "controlPlaneFlow": "flowchart LR\n  Customer[\"Customer / Agent / CI\"] --> API[\"Yalla Control Plane API\"]\n  API --> DB[(\"Postgres source of truth\")]\n  API --> Queue[\"Provisioning jobs\"]\n  Queue --> Worker[\"Yalla provisioner worker\"]\n  Worker --> Dokploy[\"Dokploy private API\"]\n  Worker --> DB\n  API --> Audit[(\"Audit log\")]\n  API --> Metrics[\"Metrics / logs / traces\"]",
    "hierarchy": "flowchart TD\n  YO[\"Yalla Organization\"] --> YP[\"Yalla Project\"]\n  YP --> YE[\"Yalla Environment\"]\n  YE --> YS[\"Yalla Service\"]\n  YO -. maps .-> DO[\"Dokploy Organization\"]\n  YP -. maps .-> DP[\"Dokploy Project\"]\n  YE -. maps .-> DE[\"Dokploy Environment\"]\n  YS -. maps .-> DS[\"Dokploy App / DB / Compose\"]",
    "authorization": "flowchart TD\n  Req[\"HTTP request\"] --> Auth[\"Authenticate principal\"]\n  Auth --> Scope[\"Resolve org/project/env/service scope\"]\n  Scope --> Policy[\"RBAC + grants + action catalog\"]\n  Policy --> Quota[\"Quota reservation for mutations\"]\n  Quota --> State[\"Write desired state\"]\n  State --> Job[\"Enqueue provisioning job\"]\n  Job --> Audit[\"Audit event\"]",
    "provisioningSequence": "sequenceDiagram\n  participant CLI as Client\n  participant API as Yalla API\n  participant DB as Postgres\n  participant Q as Job Queue\n  participant W as Worker\n  participant D as Dokploy\n  CLI->>API: POST /v1/services/{id}/deployments\n  API->>DB: authz + quota + desired deployment\n  API->>Q: enqueue job\n  API-->>CLI: 202 deployment_id\n  W->>Q: claim job\n  W->>DB: read desired state\n  W->>D: provision / deploy\n  D-->>W: upstream status + IDs\n  W->>DB: update refs and deployment status\n  CLI->>API: GET /v1/deployments/{id}\n  API-->>CLI: current status envelope",
    "variableInheritance": "flowchart TD\n  OrgVars[\"Organization variables\"] --> ProjectVars[\"Project variables\"]\n  ProjectVars --> EnvVars[\"Environment variables\"]\n  EnvVars --> ServiceVars[\"Service variables\"]\n  ServiceVars --> Rendered[\"Rendered service env for Dokploy\"]\n  Note[\"Precedence: service > environment > project > organization\"]",
    "usageMetering": "flowchart LR\n  Traffic[\"Customer traffic\"] --> Traefik[\"Traefik\"]\n  Traefik --> Service[\"Dokploy service\"]\n  Traefik --> Metrics[\"Prometheus-compatible metrics\"]\n  DokployRefs[\"Yalla dokploy_refs\"] --> Aggregator[\"Yalla usage aggregator\"]\n  Metrics --> Aggregator\n  Jobs[\"Yalla jobs and resource events\"] --> Aggregator\n  Aggregator --> UsageEvents[(\"usage_events\")]\n  Aggregator --> UsageCounters[(\"usage_counters\")]\n  UsageCounters --> Entitlements[\"Entitlement and quota checks\"]\n  UsageCounters --> Billing[\"Billing export\"]",
    "pricingModel": "flowchart TD\n  Plans[\"Plan catalog\"] --> PlanEntitlements[\"Plan entitlements\"]\n  Addons[\"Add-ons and overrides\"] --> SubscriptionEntitlements[\"Subscription entitlements\"]\n  PlanEntitlements --> Resolver[\"Entitlement resolver\"]\n  SubscriptionEntitlements --> Resolver\n  Resolver --> Quota[\"Hard/soft quota enforcement\"]\n  Resolver --> Billing[\"Metered billing rules\"]\n  Usage[\"Usage counters\"] --> Quota\n  Usage --> Billing",
    "metricAttribution": "flowchart TD\n  Metric[\"Traefik metric label: service=yalla-svc_456\"] --> Ref[\"dokploy_refs\"]\n  Ref --> Service[\"service_id svc_456\"]\n  Service --> Env[\"environment_id\"]\n  Env --> Project[\"project_id\"]\n  Project --> Org[\"org_id\"]\n  Org --> Counter[\"org-scoped usage counter\"]"
  },
  "repositoryTopology": {
    "decision": "same-repo Go monorepo",
    "reason": "The existing CLI already integrates with Dokploy. Keeping the backend in the same module lets the CLI, API, and worker reuse Dokploy client behavior, stable envelopes, typed errors, ID conventions, test utilities, and release/version metadata.",
    "binaries": {
      "cli": "cmd/yalla",
