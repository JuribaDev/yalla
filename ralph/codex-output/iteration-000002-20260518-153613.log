+	}
+	want := []string{"a.example.test/a", "a.example.test/z", "z.example.test/b"}
+	for i, row := range got {
+		key := row.Hostname + row.Path
+		if key != want[i] {
+			t.Errorf("row %d = %q, want %q", i, key, want[i])
+		}
