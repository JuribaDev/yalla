+func TestServiceDomainRepositoryCascadeFromServiceDelete(t *testing.T) {
+	t.Parallel()
+	db := testutil.RequireMigratedDB(t)
+	s := newStore(t, db)
+	repo := store.NewServiceDomainRepository()
+	f := testutil.NewFactory(t)
