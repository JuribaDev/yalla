+	if err := s.Read(ctx, func(ctx context.Context, q store.Querier) error {
+		row, err := repo.GetByID(ctx, q, orgID, serviceID, domainID)
+		if err != nil {
+			return err
+		}
+		got = row
+		return nil
+	}); err != nil {
+		t.Fatalf("GetByID(%q): %v", domainID, err)
+	}
+	return got
+}
