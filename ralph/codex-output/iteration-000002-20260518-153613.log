+
+	var deleted store.ServiceDomain
+	if err := s.Write(ctx, func(ctx context.Context, tx *store.Tx) error {
+		row, err := repo.DeleteByID(ctx, tx, org.ID, svc.ID, baseline.ID, nil)
+		if err != nil {
+			return err
+		}
+		deleted = row
+		return nil
+	}); err != nil {
