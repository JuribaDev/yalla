+func TestServiceDomainRepositoryInsertConstraintViolationsAreConflicts(t *testing.T) {
+	t.Parallel()
+	db := testutil.RequireMigratedDB(t)
+	s := newStore(t, db)
+	repo := store.NewServiceDomainRepository()
