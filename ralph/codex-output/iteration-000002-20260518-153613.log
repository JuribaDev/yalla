+	if err := s.Read(ctx, func(ctx context.Context, q store.Querier) error {
+		rows, err := repo.ListByService(ctx, q, orgID, serviceID)
+		if err != nil {
+			return err
+		}
+		got = rows
+		return nil
+	}); err != nil {
+		t.Fatalf("ListByService(%q, %q): %v", orgID, serviceID, err)
+	}
+	return got
+}
+
