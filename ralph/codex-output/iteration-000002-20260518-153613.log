+	if err := s.Write(ctx, func(ctx context.Context, tx *store.Tx) error {
+		row, err := repo.Insert(ctx, tx, d)
+		if err != nil {
+			return err
+		}
+		stored = row
+		return nil
+	}); err != nil {
+		t.Fatalf("insert service domain: %v", err)
+	}
