+	wantErrCode(t, err, yerr.CodeInternal)
+	_, err = repo.Update(ctx, nil, d, nil)
+	wantErrCode(t, err, yerr.CodeInternal)
+	_, err = repo.DeleteByID(ctx, nil, d.OrganizationID, d.ServiceID, d.ID, nil)
+	wantErrCode(t, err, yerr.CodeInternal)
+}

