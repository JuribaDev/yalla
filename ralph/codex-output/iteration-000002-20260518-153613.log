+		got.ServiceID != want.ServiceID {
+		t.Fatalf("identity = (id=%q org=%q svc=%q), want (id=%q org=%q svc=%q)",
+			got.ID, got.OrganizationID, got.ServiceID, want.ID, want.OrganizationID, want.ServiceID)
