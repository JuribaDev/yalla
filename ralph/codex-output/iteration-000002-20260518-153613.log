+	}
+	err := s.Read(ctx, func(ctx context.Context, q store.Querier) error {
+		_, getErr := repo.GetByID(ctx, q, org.ID, svc.ID, baseline.ID)
+		return getErr
+	})
+	wantErrCode(t, err, yerr.CodeNotFound)
+}
