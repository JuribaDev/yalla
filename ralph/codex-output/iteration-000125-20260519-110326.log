+		t.Errorf("level = %q, want ERROR for dependency failure", record.Level)
+	}
+	if record.ErrorCode != string(yerr.CodeDBUnavailable) {
+		t.Errorf("error_code = %q, want %s", record.ErrorCode, yerr.CodeDBUnavailable)
+	}
