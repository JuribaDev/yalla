+func statusClass(status int) string {
+	switch status / 100 {
+	case 1:
+		return "1xx"
+	case 2:
+		return "2xx"
+	case 3:
+		return "3xx"
+	case 4:
+		return "4xx"
+	case 5:
+		return "5xx"
+	default:
+		return "unknown"
+	}
+}
+
+func outcome(status int) string {
+	if status >= http.StatusBadRequest {
+		return "failure"
+	}
+	return "success"
