+	if err := matchRuntimeCopiesArtifact(model, "/out/yalla-worker", "/usr/local/bin/yalla-worker"); err != nil {
+		t.Fatalf("%s: %v", workerDockerfilePath, err)
+	}
+	if err := matchRuntimeEntrypoint(model, "/usr/local/bin/yalla-worker"); err != nil {
+		t.Fatalf("%s: %v", workerDockerfilePath, err)
+	}
+}
