+		if ins.Cmd != "COPY" {
+			continue
+		}
+		args := strings.TrimSpace(ins.Args)
+		if strings.Contains(args, wantSource) && strings.Contains(args, wantDestination) {
+			return nil
+		}
+	}
+	return fmt.Errorf("runtime stage does not copy %s to %s", wantSource, wantDestination)
+}
