+		"Health / readiness",
+		"no HTTP listener",
+		"structured JSON to stdout",
+		"service=yalla-worker",
+		"never appear in logs",
+	}
+	for _, want := range required {
+		if !strings.Contains(src, want) {
+			t.Errorf("%s: missing required operations note %q", workerDockerfilePath, want)
+		}
+	}
+}
