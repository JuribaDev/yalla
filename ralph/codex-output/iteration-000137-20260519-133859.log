+		t.Fatalf("%s: %v", workerDockerfilePath, err)
+	}
+	if err := matchNoBakedSecrets(model); err != nil {
+		t.Fatalf("%s: %v", workerDockerfilePath, err)
+	}
+	if err := matchNoRuntimePackageInstall(model); err != nil {
+		t.Fatalf("%s: %v", workerDockerfilePath, err)
