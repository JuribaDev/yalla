diff --git a/docs/operations/release-checklist.md b/docs/operations/release-checklist.md
index 492c35ee3ff740d8ba6407654b8ae2cbe9091ddb..70f8818f7ad1017a4781c9fabb52b4a796aa66c6
--- a/docs/operations/release-checklist.md
