+		"\"ok\":true",
+		"\"request_id\":\"req_",
+		"\"api_schema_version\"",
+		"\"migration_version\"",
+		"\"checks\"",
+		"Never copy the full rendered output into release notes",
+	} {
+		if !strings.Contains(checklist, want) {
+			t.Fatalf("%s missing expected-output guidance %q", releaseChecklistPath, want)
+		}
+	}
+}
