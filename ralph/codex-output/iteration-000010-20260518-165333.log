+		OrganizationID: orgID,
+		Label:          project.DisplayName,
+		DokployID:      existingID,
+	})
+	if err != nil {
+		return Terminal(err)
+	}
+
+	ensured, ensureErr := p.client.EnsureProject(ctx, in)
+	if ensureErr != nil {
+		if interrupted(ctx, ensureErr) {
