		Payload:        map[string]string{"organization_id": "org_valid"},
	})
	if !errors.Is(err, context.Canceled) {
		t.Fatalf("Run error = %v, want context.Canceled", err)
	}
	if worker.IsTerminal(err) {
		t.Fatalf("cancellation error is terminal: %v", err)
	}
}

