+
+	projectID, parseErr := domain.ParseID(project.ID)
+	if parseErr != nil || projectID.Kind() != domain.KindProject {
+		return Terminal(apierr.InvalidInput(apierr.FieldViolation{
+			Field:  "project_id",
+			Reason: "must be a valid project id",
+		}))
