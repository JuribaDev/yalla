+			Field:  "organization_id",
+			Reason: "must be a valid organization id",
+		}))
+	}
+
+	in, err := p.mapper.Project(parentDokployID, dokploy.YallaProject{
+		ID:             projectID,
+		OrganizationID: orgID,
+		Label:          project.DisplayName,
+		DokployID:      existingID,
