+		if listErr != nil {
+			return listErr
+		}
+		for _, ref := range projectRefs {
+			if ref.DokployResource == store.DokployResourceProject {
+				existingDokployID = ref.DokployID
+				return nil
+			}
+		}
+		return nil
+	})
+	if err != nil {
+		return store.Project{}, "", "", err
+	}
+	return project, parentDokployID, existingDokployID, nil
