	if err := c.post(ctx, "/api/domains", map[string]any{
		"service_id": strings.TrimSpace(in.ServiceID),
		"host":       strings.TrimSpace(in.Host),
		"https":      in.HTTPS,
	}, &d); err != nil {
		return Domain{}, err
	}
	return d, nil
}

// DeployService triggers a deployment of a service and returns the created
