+	if persisted.ErrorSummary == "" {
+		t.Fatal("persisted error summary is empty")
+	}
+	if strings.Contains(persisted.ErrorSummary, fake.Token()) {
+		t.Fatalf("persisted error summary leaked Dokploy token: %q", persisted.ErrorSummary)
