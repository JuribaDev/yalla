+		"cookie:",
+		"password:",
+		"YALLA_SIGNING_KEYS=",
+		"YALLA_SECRET_KEYS=",
+	} {
+		if strings.Contains(strings.ToLower(doc), strings.ToLower(forbidden)) {
+			t.Fatalf("%s must not contain rendered secret-looking value %q", fakeDokployUsagePath, forbidden)
+		}
+	}
+}
