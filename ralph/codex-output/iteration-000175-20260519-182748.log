+func TestFakeDokployUsageArtifactDocumentsContractsAndSafety(t *testing.T) {
+	root := projectRoot(t)
+	doc := readTextFile(t, filepath.Join(root, fakeDokployUsagePath))
+
+	for _, want := range []string{
+		"stable JSON envelopes",
