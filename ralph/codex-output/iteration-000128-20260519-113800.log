+	}
+	for check, passing := range checks {
+		status := "passing"
+		reason := "ready"
+		if !passing {
+			status = "failing"
+			reason = "pending"
+		}
+		metrics.RecordReadinessProbe(r.Context(), telemetry.ReadinessDegradationObservation{
+			Check:  check,
+			Status: status,
+			Reason: reason,
+		})
+	}
