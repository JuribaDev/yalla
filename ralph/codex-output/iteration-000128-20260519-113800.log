+func (m *ReadinessDegradationMetrics) Snapshot() ReadinessDegradationSnapshot {
+	if m == nil {
+		return ReadinessDegradationSnapshot{Series: []ReadinessDegradationMetric{}}
+	}
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	out := ReadinessDegradationSnapshot{
