+	defer m.mu.Unlock()
+	m.total++
+	series := m.series[key]
+	if series == nil {
+		series = &readinessDegradationMetricSeries{ReadinessDegradationMetric: ReadinessDegradationMetric{
+			Check:  check,
+			Status: status,
+			Reason: reason,
+		}}
+		m.series[key] = series
+	}
