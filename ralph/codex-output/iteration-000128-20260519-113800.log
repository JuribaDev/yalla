+// RecordReadinessProbe aggregates one readiness dependency-gate observation.
+func (m *ReadinessDegradationMetrics) RecordReadinessProbe(ctx context.Context, event ReadinessDegradationObservation) {
+	if m == nil {
+		return
+	}
