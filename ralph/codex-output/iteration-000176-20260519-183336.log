+		"go test ./internal/controlplane/httpapi/...",
+		"go test ./...",
+		"go test -race ./...",
+		"go vet ./...",
+		"scripts/verify.sh",
+	} {
+		if !strings.Contains(doc, want) {
+			t.Fatalf("%s missing %q", openAPIUpdateProcedurePath, want)
+		}
+	}
+}
