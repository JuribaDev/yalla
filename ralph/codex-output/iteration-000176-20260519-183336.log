+func TestOpenAPIUpdateProcedureArtifactVerificationIsWiredIntoReleaseGates(t *testing.T) {
+	root := projectRoot(t)
+	for _, tc := range []struct {
+		path string
+		want []string
+	}{
+		{
+			path: "scripts/verify.sh",
