+```bash
+sudo systemctl is-active yalla-api
+sudo systemctl is-active yalla-worker
+curl -fsS http://127.0.0.1:8080/healthz
+curl -fsS http://127.0.0.1:8080/readyz
+curl -fsS http://127.0.0.1:8080/healthz/backup
