+      exit 2
+      ;;
+  esac
+  shift
+done
+
+require_file() {
+  if [[ ! -r "$1" ]]; then
+    echo "restore-rehearsal: required file is not readable: $1" >&2
+    exit 1
+  fi
+}
+
+require_executable() {
+  if ! command -v "$1" >/dev/null 2>&1 && [[ ! -x "$1" ]]; then
