diff --git a/internal/release/restore_rehearsal_command_static_test.go b/internal/release/restore_rehearsal_command_static_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..e6c94996539138bc57c08a35785d5367de3ced27
--- /dev/null
