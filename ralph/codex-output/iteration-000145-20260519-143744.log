+	appendUsageEventWithMetadataForReconcile(t, ctx, s, events, seed, store.QuotaResourceHTTPRequests, 8, "request", "traefik", "overlap-window-b", periodStart.Add(time.Hour), periodStart.Add(3*time.Hour), map[string]string{
