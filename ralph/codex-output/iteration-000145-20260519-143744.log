+func TestUsageReconcilerClosedPeriodReplayCreatesOneLateAdjustment(t *testing.T) {
+	t.Parallel()
+	db := testutil.RequireMigratedDB(t)
+	s := newMeteringStore(t, db)
+	ctx := context.Background()
