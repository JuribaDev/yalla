+		Engine:    target.Engine,
+		Env:       target.Env,
+	})
+	if syncErr != nil {
+		if interrupted(ctx, syncErr) {
+			return syncErr
+		}
+		if apierr.Retryable(syncErr) {
+			return syncErr
+		}
+		return Terminal(syncErr)
+	}
+	return nil
+}
