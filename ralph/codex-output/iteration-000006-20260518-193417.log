+// SyncVariablesPayload is the typed schema carried by provisioning_jobs.payload
+// for JobTypeSyncVariables.
+type SyncVariablesPayload struct {
+	OrganizationID string
+	ProjectID      string
+	EnvironmentID  string
+	ServiceID      string
