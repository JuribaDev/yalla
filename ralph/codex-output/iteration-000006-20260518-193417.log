+
+		serviceType, engine, kindErr := dokploySyncKindForService(svc)
+		if kindErr != nil {
+			return kindErr
+		}
+		target.ServiceType = serviceType
+		target.Engine = engine
+		target.Env = renderDotenv(resolved.Variables)
+		return nil
+	})
+	if err != nil {
+		return syncVariablesTarget{}, err
+	}
+	return target, nil
+}
