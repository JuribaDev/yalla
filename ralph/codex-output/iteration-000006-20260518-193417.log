+		v, err = repo.Upsert(ctx, tx, domain.MustNewID(domain.KindServiceVariable).String(), svc.OrganizationID, svc.ID, key, upsert)
+		return err
+	}); err != nil {
+		t.Fatalf("insert service variable: %v", err)
+	}
+	return v
+}
