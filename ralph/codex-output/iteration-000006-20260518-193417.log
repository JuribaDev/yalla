+		if !decodeJSON(w, r, &req) {
+			return
+		}
+		id := req[idField]
+		if !requireField(w, id, idField) {
+			return
+		}
+		s.saveDatabaseServiceEnvironment(w, id, engine, req["env"])
+	}
+}
