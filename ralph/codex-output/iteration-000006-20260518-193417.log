+	Env       string `json:"env"`
+}
+
+func (s *Server) updateCompose(w http.ResponseWriter, r *http.Request) {
+	var req updateComposeRequest
+	if !decodeJSON(w, r, &req) {
+		return
+	}
+	if !requireField(w, req.ComposeID, "composeId") {
