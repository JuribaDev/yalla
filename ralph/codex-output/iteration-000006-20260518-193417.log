+	if !ok || svc.Type != serviceType {
+		writeError(w, http.StatusNotFound, "not_found", "no such service")
+		return
+	}
+	s.resources.serviceEnvs[serviceID] = env
+	writeJSON(w, http.StatusOK, map[string]any{})
