+	if err != nil {
+		t.Fatalf("NewProvisioner: %v", err)
+	}
+
+	job := syncVariablesJob(svc)
+	job.DesiredVersion = svc.Version - 1
+	err = p.Run(ctx, job)
+	if err == nil || !worker.IsTerminal(err) {
+		t.Fatalf("Run stale sync_variables = %v, want terminal error", err)
+	}
