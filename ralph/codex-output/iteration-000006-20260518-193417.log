+
+func (s *Server) saveApplicationEnvironment(w http.ResponseWriter, r *http.Request) {
+	var req saveApplicationEnvironmentRequest
+	if !decodeJSON(w, r, &req) {
+		return
+	}
+	if !requireField(w, req.ApplicationID, "applicationId") {
+		return
+	}
