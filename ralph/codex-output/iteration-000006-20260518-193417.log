+	if err != nil {
+		t.Fatalf("seal organization variable: %v", err)
+	}
+	return store.OrganizationVariableUpsert{IsSecret: true, SecretProvider: provider.ProviderID(), SecretKeyID: keyID, SecretCiphertext: ct}
