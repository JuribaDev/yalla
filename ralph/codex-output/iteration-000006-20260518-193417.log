+		}
+		projectVars, err := p.projVariables.ListByProject(ctx, q, payload.OrganizationID, payload.ProjectID)
+		if err != nil {
+			return err
+		}
+		envVars, err := p.envVariables.ListByEnvironment(ctx, q, payload.OrganizationID, payload.EnvironmentID)
+		if err != nil {
