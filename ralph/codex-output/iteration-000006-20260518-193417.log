+				if err == nil {
+					t.Fatal("ParseSyncVariablesPayload returned nil, want validation error")
+				}
+				if !worker.IsTerminal(err) {
+					t.Fatalf("validation error is not terminal: %v", err)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("ParseSyncVariablesPayload returned %v, want nil", err)
+			}
