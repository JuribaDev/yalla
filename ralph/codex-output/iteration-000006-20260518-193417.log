+type saveApplicationEnvironmentRequest struct {
+	ApplicationID string `json:"applicationId"`
+	Env           string `json:"env"`
+	BuildArgs     string `json:"buildArgs"`
+	BuildSecrets  string `json:"buildSecrets"`
