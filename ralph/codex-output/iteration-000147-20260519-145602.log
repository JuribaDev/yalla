--- /dev/null
+++ b/internal/controlplane/httpapi/admin_usage_schedules_test.go
@@ -0,0 +1,214 @@
+package httpapi
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
