+}
+
+func TestSeedAdminCommandBinarySupportsSeedAdmin(t *testing.T) {
+	root := projectRoot(t)
+	main := readTextFile(t, filepath.Join(root, "cmd/yalla-api/main.go"))
+	for _, want := range []string{
