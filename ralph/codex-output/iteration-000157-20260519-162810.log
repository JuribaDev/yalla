diff --git a/internal/release/seed_admin_command_static_test.go b/internal/release/seed_admin_command_static_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..61e00f71c85937593d99862fb7266614ce365076
--- /dev/null
