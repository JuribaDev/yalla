+			},
+		},
+		{
+			path: "SECURITY.md",
+			want: []string{
+				"## Seed Admin Command Artifact",
+				"deploy/operations/seed-admin.sh",
+				"go test ./internal/release/... -run TestSeedAdminCommand",
