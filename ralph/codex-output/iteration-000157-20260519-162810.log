+				"sudo systemctl is-active yalla-worker",
+				"/healthz",
+				"/readyz",
+				"yalla.output.v1",
+				"yalla.error.v1",
+				"structured JSON",
+			},
+		},
+		{
+			path: "scripts/verify.sh",
