+		`StringVar(&opts.seedAdminRole, "seed-admin-role"`,
+		`runSeedAdminCommand(ctx, pool, logger, opts)`,
+		`seed admin command completed`,
+	} {
+		if !strings.Contains(main, want) {
+			t.Fatalf("cmd/yalla-api/main.go missing %q", want)
+		}
+	}
+}
