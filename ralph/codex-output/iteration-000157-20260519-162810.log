// FindByPrefix returns the API key whose public prefix is prefix. This is the
// authentication lookup, and it is the ONE repository read that is deliberately
// NOT tenant-scoped: authentication happens before the caller's tenant is
// known, and the prefix itself is the lookup key. The prefix is globally unique
// (a UNIQUE constraint) and unguessable, and the row it returns carries its own
// OrganizationID, so every caller scopes subsequent work by key.OrganizationID.
//
// Finding the row is not authentication: the caller must still verify the
// secret with a constant-time hash comparison (auth.VerifySecret) and check
// APIKey.IsUsable. A missing prefix is reported as a typed apierr.NotFound; the
// auth layer maps that to an Unauthenticated response.
func (r *APIKeyRepository) FindByPrefix(ctx context.Context, q Querier, prefix string) (APIKey, error) {
	row := q.QueryRow(ctx,
		`SELECT `+apiKeyColumns+` FROM api_keys WHERE prefix = $1`, prefix)
	k, err := scanAPIKey(row)
	if errors.Is(err, pgx.ErrNoRows) {
		return APIKey{}, apierr.NotFound("api_key", prefix)
	}
	if err != nil {
		return APIKey{}, apierr.StoreUnavailable(err)
	}
	return k, nil
}

