diff --git a/internal/release/on_call_dashboard_artifact_static_test.go b/internal/release/on_call_dashboard_artifact_static_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..54552e7402c62397647d0e667ce318079efa61c7
