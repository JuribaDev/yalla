+func (p *Provisioner) runDeleteService(ctx context.Context, job store.ProvisioningJob) error {
+	if job.Status == store.JobStatusSucceeded {
+		return nil
+	}
+	payload, err := ParseDeleteServicePayload(job)
+	if err != nil {
+		return err
