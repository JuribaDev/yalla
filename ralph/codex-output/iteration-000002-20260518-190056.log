+				if !worker.IsTerminal(err) {
+					t.Fatalf("validation error is not terminal: %v", err)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("ParseDeleteServicePayload returned %v, want nil", err)
+			}
+		})
+	}
+}
