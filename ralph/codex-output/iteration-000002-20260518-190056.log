func pRunEnsureOrg(ctx context.Context, t *testing.T, s *store.Store, client *dokploy.Client, org store.Organization) error {
	t.Helper()
	p, err := worker.NewProvisioner(worker.ProvisionerConfig{
		Store:  s,
		Client: client,
		Mapper: dokploy.NewMapper(),
