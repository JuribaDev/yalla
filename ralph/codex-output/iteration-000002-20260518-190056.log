+	if err != nil {
+		return err
+	}
+
+	removeErr := p.client.RemoveService(ctx, dokploy.RemoveServiceInput{ServiceID: dokployServiceID})
+	if removeErr != nil {
+		if interrupted(ctx, removeErr) {
+			return removeErr
+		}
+		if apierr.Retryable(removeErr) {
+			return removeErr
+		}
+		return Terminal(removeErr)
+	}
+	return nil
+}
