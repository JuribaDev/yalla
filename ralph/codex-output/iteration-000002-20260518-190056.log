+		t.Fatalf("replayed succeeded delete job: %v", err)
+	}
+	if reqs := fake.Requests(); len(reqs) != 5 {
+		t.Fatalf("replayed succeeded delete issued another Dokploy request: %+v", reqs)
+	}
+}
