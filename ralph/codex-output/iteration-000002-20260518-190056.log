+			}
+		}
+		if dokployServiceID == "" {
+			return Terminal(apierr.Conflict("service Dokploy mapping is required before deleting a service"))
+		}
+		return nil
+	})
+	if err != nil {
+		return "", err
+	}
+	return dokployServiceID, nil
+}
