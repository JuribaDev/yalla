+		t.Fatalf("error summary leaked token: %q", persisted.ErrorSummary)
+	}
+	if !strings.Contains(persisted.ErrorSummary, "Dokploy") {
+		t.Fatalf("error summary = %q, want redacted Dokploy failure context", persisted.ErrorSummary)
+	}
