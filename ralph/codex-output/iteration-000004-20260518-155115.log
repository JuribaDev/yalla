+	if strings.Contains(body, cause) || strings.Contains(body, "10.44.0.19") {
+		t.Errorf("error envelope leaked the wrapped dependency cause: %s", body)
+	}
+	if strings.Contains(body, getServiceRenderedContractSecret) {
