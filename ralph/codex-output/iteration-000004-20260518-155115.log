+
+	rec := getServiceRenderedWithRequestID(handler, canonicalServiceForRendered.ID, "a-valid-token", requestID)
+	if rec.Code != http.StatusOK {
+		t.Fatalf("status = %d, want 200; body %s", rec.Code, rec.Body.String())
+	}
