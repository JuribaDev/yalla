+			if rt.resolver == nil {
+				t.Error("resolver is nil; rendered route must use serviceIDResolver")
+			}
+		}
+	}
+	if !found {
+		t.Error("OpenAPI route GET /v1/services/{service_id}/rendered is not registered")
+	}
+}
