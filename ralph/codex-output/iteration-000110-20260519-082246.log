diff --git a/internal/controlplane/httpapi/server.go b/internal/controlplane/httpapi/server.go
index 22ff64eae12bdbe9cc2973dbe71111352b23daa4..e71f1e3b3154f6d8450ac5073c58d2bb206d1a4a
