+func planEntitlementKeys(candidate candidateConfig) map[string]struct{} {
+	keys := map[string]struct{}{}
+	for _, plan := range candidate.Plans {
+		for _, ent := range plan.Entitlements {
+			if key := strings.TrimSpace(ent.Key); key != "" {
