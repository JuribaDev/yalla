+		"export YALLA_POSTGRES_PASSWORD=<redacted:postgres-password>",
+		"expected output",
+		"ok",
+		"YALLA_TEST_DATABASE_URL not set; skipping Postgres integration test",
+		"schema_version: yalla.output.v1",
+		"schema_version: yalla.error.v1",
+		"request_id",
+		"E_QUOTA_EXCEEDED",
+		"Failure recovery",
