+		"organization_id",
+		"tenant isolation",
+		"Yalla API -> Postgres source of truth -> worker -> private Dokploy API",
+		"go test ./internal/controlplane/quota/...",
+		"go test ./internal/controlplane/store/...",
+		"go test -run TestQuotaConcurrency ./...",
