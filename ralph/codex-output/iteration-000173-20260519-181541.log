+		"idempotency",
+		"audit",
+		"soft-limit warnings",
+		"hard-limit rejection",
+		"cross-tenant IDs",
+	} {
+		if !strings.Contains(doc, want) {
+			t.Fatalf("%s missing %q", quotaImplementationGuidePath, want)
+		}
+	}
+	for _, forbidden := range []string{
+		"postgres://",
+		"postgresql://",
+		"Bearer ",
+		"api-key-",
+		"dokploy-service-token",
+		"cookie:",
