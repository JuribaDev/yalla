+		}
+	}
+}
+
+func TestQuotaImplementationGuideArtifactDocumentsOutputsAndRecovery(t *testing.T) {
+	root := projectRoot(t)
+	doc := readTextFile(t, filepath.Join(root, quotaImplementationGuidePath))
+
+	for _, want := range []string{
