+func (s *Server) popMonitoringFault(source string) (Fault, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	queue := s.monitoringFaults[source]
+	if len(queue) == 0 {
+		return Fault{}, false
+	}
+	fault := queue[0]
+	s.monitoringFaults[source] = queue[1:]
+	return fault, true
+}
