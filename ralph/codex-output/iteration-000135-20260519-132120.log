/bin/zsh -lc 'gofmt -w internal/controlplane/metering/dokploy_test.go && go test -race ./internal/controlplane/metering -run TestDokployMetricsAdapterDegradesUnavailableMonitoring -count=3' in /Users/juribadev/projects/poc/yalla
