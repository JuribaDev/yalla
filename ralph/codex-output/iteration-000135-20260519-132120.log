+func (s *Server) redactRawQuery(raw string) string {
+	if raw == "" {
+		return ""
+	}
+	values, err := url.ParseQuery(raw)
+	if err != nil {
+		return s.redactor.Redact(raw)
+	}
+	for _, key := range []string{"token", "access_token", "api_key", "apikey", "password", "secret"} {
