+func (s *Server) QueueMonitoringFault(source string, faults ...Fault) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	source = strings.TrimSpace(source)
+	s.monitoringFaults[source] = append(s.monitoringFaults[source], faults...)
