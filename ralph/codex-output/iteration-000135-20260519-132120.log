+func (s *Server) SetApplicationMonitoring(appName string, payload map[string]any) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.resources.appMonitoring[strings.TrimSpace(appName)] = clonePayload(payload)
