}

func seedDeploymentUsageAttempt(t *testing.T, db *testutil.DB, orgID, jobID string, attempt int, status store.JobAttemptStatus, startedAt, finishedAt time.Time) {
	t.Helper()
	if _, err := db.Exec(context.Background(),
