 	if e == nil || e.store == nil || e.usage == nil {
@@ -167,6 +196,8 @@
 	switch key {
 	case "active_services":
 		return store.QuotaResourceActiveServices, true
+	case "active_databases":
+		return store.QuotaResourceActiveDatabases, true
 	default:
 		return "", false
 	}
