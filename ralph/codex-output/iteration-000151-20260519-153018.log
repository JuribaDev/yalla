+-- Remove the non-billing active service current-state metric resource.
+
+DO $$
+DECLARE
+    cname text;
+BEGIN
+    SELECT conname
+      INTO cname
+      FROM pg_constraint
+     WHERE contypid = 'quota_resource'::regtype
+       AND contype  = 'c'
+     LIMIT 1;
+    IF cname IS NOT NULL THEN
