@@ -0,0 +1,53 @@
+-- Add the non-billing active service current-state metric resource.
+
+DO $$
+DECLARE
+    cname text;
+BEGIN
+    SELECT conname
+      INTO cname
+      FROM pg_constraint
+     WHERE contypid = 'quota_resource'::regtype
+       AND contype  = 'c'
+     LIMIT 1;
+    IF cname IS NOT NULL THEN
+        EXECUTE format('ALTER DOMAIN quota_resource DROP CONSTRAINT %I', cname);
+    END IF;
+END;
+$$;
+
+ALTER DOMAIN quota_resource ADD CONSTRAINT quota_resource_check
+    CHECK (VALUE IN (
+        'projects',
+        'environments',
+        'services',
+        'applications',
