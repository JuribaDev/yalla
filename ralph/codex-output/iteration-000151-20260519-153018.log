+func TestActiveServicesMetricDefinition(t *testing.T) {
+	t.Parallel()
+
+	def, ok := LookupMetricDefinition("active_services")
+	if !ok {
+		t.Fatal("LookupMetricDefinition(active_services) missing")
+	}
