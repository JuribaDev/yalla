diff --git a/internal/controlplane/store/migrate/migrations/0073_active_services_metering_resource.down.sql b/internal/controlplane/store/migrate/migrations/0073_active_services_metering_resource.down.sql
new file mode 100644
index 0000000000000000000000000000000000000000..9a7c4664d04d16ae272b27346d7edcac4ad5daf6
--- /dev/null
+++ b/internal/controlplane/store/migrate/migrations/0073_active_services_metering_resource.down.sql
@@ -0,0 +1,52 @@
+-- Remove the non-billing active service current-state metric resource.
+
+DO $$
+DECLARE
+    cname text;
+BEGIN
+    SELECT conname
+      INTO cname
+      FROM pg_constraint
+     WHERE contypid = 'quota_resource'::regtype
+       AND contype  = 'c'
+     LIMIT 1;
+    IF cname IS NOT NULL THEN
+        EXECUTE format('ALTER DOMAIN quota_resource DROP CONSTRAINT %I', cname);
+    END IF;
+END;
+$$;
+
+ALTER DOMAIN quota_resource ADD CONSTRAINT quota_resource_check
+    CHECK (VALUE IN (
+        'projects',
+        'environments',
+        'services',
+        'applications',
+        'compose_stacks',
+        'databases',
+        'domains',
+        'preview_environments',
+        'cpu_millicores',
+        'memory_mb',
+        'storage_gb',
+        'backups',
+        'backup_schedules',
+        'api_keys',
+        'members',
+        'concurrent_deployments',
+        'monthly_deployments',
+        'deployments',
+        'failed_deployments',
+        'build_minutes',
+        'http_requests',
+        'http_response_bytes',
+        'http_request_bytes',
+        'http_bandwidth_total',
+        'container_cpu_millicore_seconds',
+        'container_memory_mb_hours',
+        'storage_gb_month',
+        'backup_storage_gb_month',
+        'http_rps_peak_1m',
+        'http_5xx_count',
+        'latency_p95_ms'
+    ));
