diff --git a/internal/controlplane/apierr/apierr.go b/internal/controlplane/apierr/apierr.go
index 1e1ba2689c6f83b2a45cc6fce0b26b9f0dd3a507..16cb6800312b3c1287bbcd9a9c3c3419371a995e
