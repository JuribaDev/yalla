+// metering before a sample becomes billing-grade usage.
+type BackupArtifactStatus string
+
+const (
+	BackupArtifactSucceeded BackupArtifactStatus = "succeeded"
+	BackupArtifactFailed    BackupArtifactStatus = "failed"
+)
