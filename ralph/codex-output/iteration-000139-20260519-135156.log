+func TestBuildStorageGBMonthSampleProratesCreateDeleteMidPeriod(t *testing.T) {
+	t.Parallel()
+	periodStart := time.Date(2026, 5, 1, 0, 0, 0, 0, time.UTC)
+	periodEnd := time.Date(2026, 6, 1, 0, 0, 0, 0, time.UTC)
