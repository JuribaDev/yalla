+	metadata["period_end"] = in.PeriodEnd.UTC().Format(time.RFC3339Nano)
+	metadata["size_bytes"] = strconv.FormatInt(in.SizeBytes, 10)
+	metadata["backup_status"] = string(BackupArtifactSucceeded)
