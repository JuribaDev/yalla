+		ProjectID:      strings.TrimSpace(in.ProjectID),
+		EnvironmentID:  strings.TrimSpace(in.EnvironmentID),
+		ServiceID:      strings.TrimSpace(in.ServiceID),
+		Metadata:       metadata,
