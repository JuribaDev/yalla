+		Source:         "backup_metadata",
+	})
+	if err != nil {
+		t.Fatalf("failed BuildBackupStorageGBMonthSample: %v", err)
+	}
+	if ok || failed.Value != 0 {
+		t.Fatalf("failed backup sample = %+v ok=%v, want skipped without billable usage", failed, ok)
+	}
