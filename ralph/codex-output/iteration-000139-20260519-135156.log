internal/controlplane/httpapi/routes.go:2385:				SuccessDescription: "The persisted service backup after the update.",
internal/controlplane/httpapi/routes.go:2387:			// serviceIDResolver authorizes action backup.update against
internal/controlplane/httpapi/routes.go:2389:			// the path names — the {backup_id} path parameter does not
