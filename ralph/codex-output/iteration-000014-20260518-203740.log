	ID                  string
	OrganizationID      string
	ProjectID           string
	EnvironmentID       string
	Slug                string
	DisplayName         string
	Kind                string
	Version             int64
	CreatedAt           time.Time
	UpdatedAt           time.Time
	DeletionScheduledAt *time.Time
}

