+	}
+	if scanner.calls != 0 {
+		t.Fatalf("stale job called scanner %d times, want 0", scanner.calls)
+	}
+	if projects := listWorkerProjects(ctx, t, dataStore, org.ID); len(projects) != 0 {
+		t.Fatalf("projects after stale import = %d, want 0", len(projects))
+	}
+}
