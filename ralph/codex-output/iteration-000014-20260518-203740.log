+	}
+	services := listWorkerServices(ctx, t, dataStore, org.ID, envs[0].ID)
+	if len(services) != 1 {
+		t.Fatalf("imported services = %d, want 1", len(services))
+	}
+	if got := len(listProjectRefs(ctx, t, dataStore, org.ID, projects[0].ID)); got != 1 {
