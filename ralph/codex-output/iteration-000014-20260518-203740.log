+func TestProvisionerImportDokployResourceRetryableScannerFailureDoesNotPersist(t *testing.T) {
+	t.Parallel()
+
+	ctx := context.Background()
+	db := testutil.RequireMigratedDB(t)
+	dataStore, err := store.New(db.Pool, nil)
