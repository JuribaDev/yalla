+		project, err = r.projects.Get(ctx, q, r.organizationID, ref.YallaID)
+		return err
+	})
+	if err != nil {
+		return migrateimport.ExistingProject{}, err
+	}
+	return migrateimport.ExistingProject{ID: domain.ID(project.ID), DokployID: ref.DokployID}, nil
+}
