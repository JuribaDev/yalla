+	}
+	if worker.IsTerminal(err) {
+		t.Fatalf("scanner failure is terminal: %v", err)
+	}
+	if !apierr.Retryable(err) {
+		t.Fatalf("scanner failure is not retryable: %v", err)
+	}
+	if strings.Contains(err.Error(), "dkp_secret_0123456789abcdef") {
