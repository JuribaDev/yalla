+		},
+		Projects: []migrateimport.SnapshotProject{
+			{
+				DokployID:             "dokploy_project_import",
+				DokployOrganizationID: dokployOrgID,
+				Name:                  "Imported Project",
+			},
+		},
+		Environments: []migrateimport.SnapshotEnvironment{
