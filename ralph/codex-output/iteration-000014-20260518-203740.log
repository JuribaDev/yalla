+			wantErr: true,
+		},
+		{
+			name: "resource scoped job",
+			job: store.ProvisioningJob{
+				OrganizationID: "org_valid",
+				ProjectID:      "proj_forbidden",
+				JobType:        worker.JobTypeImportDokployResource,
