+				OrganizationID: "org_valid",
+				JobType:        worker.JobTypeImportDokployResource,
+				Payload: map[string]string{
+					"organization_id":         "org_valid",
+					"yalla_organization_id":   "org_other",
+					"dokploy_organization_id": "dokploy_org_valid",
+				},
