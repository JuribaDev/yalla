diff --git a/internal/controlplane/worker/import_dokploy_resource.go b/internal/controlplane/worker/import_dokploy_resource.go
new file mode 100644
index 0000000000000000000000000000000000000000..5aa0dc69c988e037b3924a069730546d932450a6
--- /dev/null
