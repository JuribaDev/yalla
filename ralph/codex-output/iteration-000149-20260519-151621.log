+			WindowEnd:         start.Add(time.Minute),
+			QueryVersion:      "traefik-prom-v1",
+			RawSampleChecksum: "fivehundredabcdef123456",
+			Labels:            map[string]string{"cookie": "session=should-not-leak"},
+		},
