+	}
+	if !stderrors.Is(err, cause) {
+		t.Fatal("DokployForbidden must preserve the cause for server-side logging")
+	}
+
+	rec := httptest.NewRecorder()
+	apienvelope.WriteError(rec, "req-dokploy-forbidden", err)
+	body := rec.Body.String()
