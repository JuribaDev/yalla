+			got = doc.Description
+			break
+		}
+	}
+	const want = "upstream Dokploy provisioning backend denied the requested operation"
+	if got != want {
+		t.Fatalf("E_DOKPLOY_FORBIDDEN description = %q, want %q", got, want)
+	}
+}
