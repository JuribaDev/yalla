+	c := newTestClient(t, fake)
+	fake.QueueFault(dokployfake.StatusFault(http.StatusForbidden))
+
+	_, err := c.EnsureOrganization(context.Background(), dokploy.EnsureOrganizationInput{Name: "acme"})
