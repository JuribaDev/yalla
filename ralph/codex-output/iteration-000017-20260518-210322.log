+		actorID = strings.TrimSpace(previous.LeaseOwner)
+		if actorKind == "" {
+			actorKind = "worker"
+		}
+	}
+	if actorID == "" {
+		actorID = "system"
+	}
+	if actorKind == "" {
+		actorKind = "system"
+	}
+
