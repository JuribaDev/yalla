// would return if it were (incorrectly) reached. The body-leak
// guard needles for these recognisable values, so an accidental
// on-deny render of the "created" backup fails the test even before
// the creator-not-reached assertion. The version is deliberately
// non-zero so a wire response that surfaced this row would be
// distinguishable from a zero-value envelope.
func canonicalCreatedServiceBackup(orgID, serviceID string) store.ServiceBackup {
	return store.ServiceBackup{
		ID:             canonicalBackupMatrixBackupID,
		OrganizationID: orgID,
		ServiceID:      serviceID,
		DisplayName:    canonicalBackupMatrixDisplayName,
		Schedule:       canonicalBackupMatrixSchedule,
		RetentionCount: 7,
		Enabled:        true,
		Status:         store.ServiceBackupStatusPending,
		Version:        1,
	}
