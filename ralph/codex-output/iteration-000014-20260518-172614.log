diff --git a/internal/controlplane/httpapi/service_backups_get_contract_test.go b/internal/controlplane/httpapi/service_backups_get_contract_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..a6da1f50d645fa7cc3f117823a7daa05bbec85d6
