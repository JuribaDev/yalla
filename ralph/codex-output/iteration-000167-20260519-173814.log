+		"deploy/operations/restore-rehearsal.sh --dry-run",
+		"deploy/operations/migrate-database.sh --dry-run",
+		"/usr/local/bin/yalla-api --migrate-only",
+		"fresh encrypted backup",
+		"restore rehearsal",
+		"reversible",
