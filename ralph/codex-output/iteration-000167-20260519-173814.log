+}
+
+func TestRollbackChecklistArtifactDocumentsVerification(t *testing.T) {
+	root := projectRoot(t)
+	checklist := readTextFile(t, filepath.Join(root, rollbackChecklistPath))
+
+	for _, want := range []string{
+		"gofmt -w .",
