+		"Postgres source of truth",
+		"Provisioning worker",
+		"private Dokploy API",
+		"schema_version: yalla.output.v1",
+		"schema_version: yalla.error.v1",
+		"request_id",
+		"correlation_id",
+	} {
+		if !strings.Contains(checklist, want) {
+			t.Fatalf("%s missing %q", rollbackChecklistPath, want)
+		}
+	}
+}
