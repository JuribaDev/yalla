+		"request bodies",
+		"response bodies",
+		"<redacted:YALLA_DATABASE_URL>",
+	} {
+		if !strings.Contains(checklist, want) {
+			t.Fatalf("%s missing %q", rollbackChecklistPath, want)
+		}
+	}
+	for _, forbidden := range []string{
+		"postgres://",
+		"postgresql://",
+		"Bearer ",
+		"api-key-",
+		"dokploy-service-token",
+		"cookie:",
+		"password:",
