+    ('plan_pro_monthly_v1', 'pro', 'Pro', 'active', 'monthly', 20, 1),
+    ('plan_business_monthly_v1', 'business', 'Business', 'active', 'monthly', 30, 1),
+    ('plan_enterprise_monthly_v1', 'enterprise', 'Enterprise', 'active', 'monthly', 40, 1);
+
