+	}
+	if listA[0].ID != rowA.ID || listA[0].OrganizationID != fixture.orgA.ID || listA[0].ProjectID != fixture.projA.ID {
+		t.Errorf("ListByProject(orgA, projA)[0] = %+v, want orgA row %+v", listA[0], rowA)
+	}
