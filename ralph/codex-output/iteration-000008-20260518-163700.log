+	}
+	if listB[0].ID != rowB.ID || listB[1].ID != rowB2.ID {
+		t.Errorf("ListByProject(orgB, projB) order = [%q, %q], want created_at/id deterministic order [%q, %q]",
+			listB[0].ID, listB[1].ID, rowB.ID, rowB2.ID)
