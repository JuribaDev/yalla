+	}
+}
+
+func TestPreviewEnvironmentRepositorySoftDeletedRowsRemainTenantScoped(t *testing.T) {
+	t.Parallel()
+	db := testutil.RequireMigratedDB(t)
+	s := newStore(t, db)
+	repo := store.NewPreviewEnvironmentRepository()
+	f := testutil.NewFactory(t)
