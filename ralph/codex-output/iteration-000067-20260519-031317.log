+			t.Fatalf("status = %d, want 403; body %s", rec.Code, rec.Body.String())
+		}
+		decodeError(t, rec, "E_FORBIDDEN")
+		if got.OrganizationID != "" {
+			t.Fatalf("Revoke called on authorization failure: %+v", got)
+		}
+	})
+
+	t.Run("not_found", func(t *testing.T) {
