+func TestDeleteAdminBreakGlassContractErrorPaths(t *testing.T) {
+	t.Parallel()
+
+	homeOrg := string(domain.MustNewID(domain.KindOrganization))
+	targetOrg := string(domain.MustNewID(domain.KindOrganization))
