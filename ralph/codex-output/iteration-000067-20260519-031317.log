+		req := httptest.NewRequest(http.MethodDelete, "/v1/admin/break-glass/"+sessionID+"?organization_id="+targetOrg, nil)
+		req.Header.Set("X-Request-Id", "req_admin_break_glass_delete_unauthenticated")
