+	revoked.Status = store.BreakGlassSessionStatusRevoked
+	revokedAt := now.Add(time.Minute)
+	revoked.RevokedAt = &revokedAt
+	revoked.RevokedByID = "usr_support"
+	revoked.RevokedByKind = "usr"
+
+	var logBuf bytes.Buffer
