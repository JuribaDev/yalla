+func addRPSPeakSamples(samples map[string]TraefikMetricSample, start, end time.Time, version string) {
+	windowSeconds := end.Sub(start).Seconds()
+	if windowSeconds <= 0 {
+		return
+	}
+	requests := map[string]float64{}
+	for _, sample := range samples {
+		if sample.Name != "http_requests" || sample.Bucket != "" {
+			continue
+		}
+		requests[sample.Service] += sample.Value
+	}
+	for service, total := range requests {
+		sample := TraefikMetricSample{
+			Name:         "http_rps_peak_1m",
+			Service:      service,
+			Value:        total / windowSeconds,
+			Unit:         "requests_per_second",
+			WindowStart:  start,
+			WindowEnd:    end,
+			QueryVersion: version,
+			Labels:       map[string]string{"service": service},
+		}
+		samples[sample.aggregateKey()] = sample
+	}
+}
+
 func (s TraefikMetricSample) aggregateKey() string {
 	return s.Name + "\x00" + s.Service + "\x00" + s.Status + "\x00" + s.Bucket
 }
