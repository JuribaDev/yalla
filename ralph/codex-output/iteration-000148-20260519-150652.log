diff --git a/internal/controlplane/store/migrate/migrations/0070_http_rps_peak_1m_metering_resource.down.sql b/internal/controlplane/store/migrate/migrations/0070_http_rps_peak_1m_metering_resource.down.sql
new file mode 100644
index 0000000000000000000000000000000000000000..1863db83605d044a905dcb94378143c6f79af24b
--- /dev/null
+++ b/internal/controlplane/store/migrate/migrations/0070_http_rps_peak_1m_metering_resource.down.sql
@@ -0,0 +1,49 @@
+-- Remove the soft HTTP requests-per-second peak resource.
+
+DO $$
+DECLARE
+    cname text;
+BEGIN
+    SELECT conname
+      INTO cname
+      FROM pg_constraint
+     WHERE contypid = 'quota_resource'::regtype
+       AND contype  = 'c'
+     LIMIT 1;
+    IF cname IS NOT NULL THEN
+        EXECUTE format('ALTER DOMAIN quota_resource DROP CONSTRAINT %I', cname);
+    END IF;
+END;
