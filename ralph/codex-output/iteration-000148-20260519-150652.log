func promValues(vals ...float64) [][]any {
	out := make([][]any, 0, len(vals))
	for i, v := range vals {
		out = append(out, []any{float64(1770000000 + i*15), jsonNumber(v)})
	}
	return out
}

func jsonNumber(v float64) string {
	b, _ := json.Marshal(v)
	return string(b)
}
