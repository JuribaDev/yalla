+		},
+		OrganizationID:    seed.OrganizationID,
+		ProjectID:         seed.ProjectID,
+		EnvironmentID:     seed.EnvironmentID,
+		ServiceID:         seed.ServiceID,
+		AttributionSource: metering.TraefikAttributionSourceLabel,
