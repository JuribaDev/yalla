diff --git a/internal/release/api_handler_conventions_static_test.go b/internal/release/api_handler_conventions_static_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..6cbc10469b9528f3b3444ea3f6dd7f8fcf42df41
--- /dev/null
