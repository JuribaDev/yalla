+	}
+	if get.RequiredAction != string(policy.ActionJobRead) {
+		t.Errorf("x-required-action = %q, want %q", get.RequiredAction, policy.ActionJobRead)
+	}
+	if _, ok := get.Responses["200"]; !ok {
+		t.Error("responses[200] missing")
+	}
