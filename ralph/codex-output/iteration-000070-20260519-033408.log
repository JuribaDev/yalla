+func TestJobNotClaimedDescriptionNamesLeaseOwnership(t *testing.T) {
+	t.Parallel()
+
+	var got string
+	for _, doc := range AllCodes() {
+		if doc.Code == string(CodeJobNotClaimed) {
+			got = doc.Description
+			break
+		}
+	}
