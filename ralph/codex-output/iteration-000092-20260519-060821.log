			event.OrganizationID, event.ProjectID, event.EnvironmentID).Scan(&ok); err != nil {
			return apierr.StoreUnavailable(err)
		}
		if !ok {
			return apierr.NotFound("environment", event.EnvironmentID)
		}
	}
	if event.ServiceID != "" {
		if err := q.QueryRow(ctx,
