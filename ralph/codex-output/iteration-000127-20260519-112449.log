+	queryKind := queryKind(sql)
+	outcome := "success"
+	if err != nil {
+		outcome = "error"
+	}
+	if s.slowQueryMetrics != nil {
+		s.slowQueryMetrics.RecordSlowQuery(ctx, telemetry.SlowQueryObservation{
+			Operation: operation,
+			QueryKind: queryKind,
+			Outcome:   outcome,
+			Duration:  elapsed,
+			Threshold: s.slowQueryThreshold,
+		})
+	}
