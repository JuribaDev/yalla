+	raw := buf.String()
+	if strings.Contains(raw, "postgres://user:secret@db/yalla") {
+		t.Fatalf("slow query failure log leaked error detail: %s", raw)
+	}
+	got := findStoreSlowQueryMetric(metrics.Snapshot().Series, "write", "update", "error")
