+func (q readQuerier) Exec(ctx context.Context, sql string, args ...any) (pgconn.CommandTag, error) {
+	start := time.Now()
+	tag, err := q.q.Exec(ctx, sql, args...)
+	q.store.observeQuery(ctx, "read", sql, time.Since(start), err)
+	return tag, err
+}
