+		Operation: "read",
+		QueryKind: "select",
+		Outcome:   "success",
+		Duration:  1500 * time.Millisecond,
+		Threshold: 250 * time.Millisecond,
+	})
+	metrics.RecordSlowQuery(context.Background(), SlowQueryObservation{
+		Operation: "write",
+		QueryKind: "insert",
+		Outcome:   "error",
+		Duration:  275 * time.Millisecond,
+		Threshold: 250 * time.Millisecond,
+	})
+
