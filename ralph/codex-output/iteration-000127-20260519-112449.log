+func (m *SlowQueryMetrics) Snapshot() SlowQueryMetricsSnapshot {
+	if m == nil {
+		return SlowQueryMetricsSnapshot{Series: []SlowQueryMetric{}}
+	}
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	out := SlowQueryMetricsSnapshot{
+		TotalQueries: m.total,
