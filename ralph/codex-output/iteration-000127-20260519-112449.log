+	if got.OrganizationID != "" || got.PrincipalID != "usr_slow_safe" || got.ResourceKind != "" || got.ResourceID != "svc_slow_safe" {
+		t.Errorf("identifier hints = %+v, want only SafeID-clean values", *got)
