+func (q readQuerier) Query(ctx context.Context, sql string, args ...any) (pgx.Rows, error) {
+	start := time.Now()
+	rows, err := q.q.Query(ctx, sql, args...)
+	q.store.observeQuery(ctx, "read", sql, time.Since(start), err)
+	return rows, err
