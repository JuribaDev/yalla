+	if strings.HasPrefix(sql, "/*") {
+		if i := strings.Index(sql, "*/"); i >= 0 {
+			sql = strings.TrimSpace(sql[i+2:])
+		}
+	}
+	fields := strings.Fields(sql)
+	if len(fields) == 0 {
+		return "unknown"
+	}
+	switch strings.ToLower(fields[0]) {
