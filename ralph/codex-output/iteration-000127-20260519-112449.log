+	ctx = telemetry.WithLogFields(ctx)
+	telemetry.SetOrgID(ctx, "org_store_slow")
+	telemetry.SetPrincipalID(ctx, "usr_store_slow")
+	telemetry.SetResource(ctx, "project", "proj_store_slow")
+	telemetry.SetJobID(ctx, "job_store_slow")
