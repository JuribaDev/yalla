+		return
+	}
+	operation := metricStoreOperation(event.Operation)
+	queryKind := metricQueryKind(event.QueryKind)
+	outcome := metricStoreOutcome(event.Outcome)
+	durationMS := event.Duration.Milliseconds()
+	if durationMS < 0 {
