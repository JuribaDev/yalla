+func TestStoreObserveQuerySkipsFastQueriesAndRecordsFailures(t *testing.T) {
+	t.Parallel()
+
+	var buf bytes.Buffer
+	metrics := telemetry.NewSlowQueryMetrics()
+	s := &Store{
