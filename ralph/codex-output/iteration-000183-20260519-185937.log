+}
+
+func TestTenantImportPlaybookArtifactDocumentsRecoveryAndRedaction(t *testing.T) {
+	root := projectRoot(t)
+	playbook := readTextFile(t, filepath.Join(root, tenantImportPlaybookPath))
+
+	for _, want := range []string{
