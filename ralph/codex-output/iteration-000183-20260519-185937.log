+		"api-key-",
+		"dokploy-service-token",
+		"cookie:",
+		"password:",
+	} {
+		if strings.Contains(strings.ToLower(playbook), strings.ToLower(forbidden)) {
+			t.Fatalf("%s must not contain rendered secret-looking value %q", tenantImportPlaybookPath, forbidden)
+		}
+	}
+}
