diff --git a/internal/controlplane/reconcile/worker_test.go b/internal/controlplane/reconcile/worker_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..ed54b7b4421a6a7f52a249bfe09526bcce15ada1
--- /dev/null
