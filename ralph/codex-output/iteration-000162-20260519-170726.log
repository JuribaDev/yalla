+		if !strings.Contains(runbook, want) {
+			t.Fatalf("%s missing %q", deploymentRunbookPath, want)
+		}
+	}
+}
+
+func TestDeploymentRunbookArtifactDocumentsLeastPrivilegeAndSecrets(t *testing.T) {
+	root := projectRoot(t)
