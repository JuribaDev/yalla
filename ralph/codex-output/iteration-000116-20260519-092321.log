+func TestClientRecordsDokployDependencyMetrics(t *testing.T) {
+	t.Parallel()
+	fake := dokployfake.New()
+	defer fake.Close()
+	metrics := telemetry.NewDokployDependencyMetrics()
+	c := newTestClient(t, fake, func(cfg *dokploy.Config) {
+		cfg.Metrics = metrics
+		cfg.MaxRetries = -1
+	})
