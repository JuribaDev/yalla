+		}
+		if dokployPathSegmentIsID(parts, i) {
+			parts[i] = "{id}"
+		}
+	}
+	normalized := strings.Join(parts, "/")
+	if normalized == "" || normalized == "/" {
+		return "unknown"
+	}
+	return normalized
