+	if errorCode != "" || event.StatusCode >= 400 {
+		outcome = "failure"
+	}
+	if errorCode != "" {
+		statusClass = "dependency_error"
+	}
+	latencyMS := event.Latency.Milliseconds()
+	if latencyMS < 0 {
+		latencyMS = 0
+	}
+
