 	}
 	defer func() { _ = resp.Body.Close() }()
+	statusCode = resp.StatusCode
 
 	payload, _ := io.ReadAll(io.LimitReader(resp.Body, maxResponseBody))
 
@@ -275,6 +302,17 @@
