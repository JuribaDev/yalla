+func TestDokployDependencyMetricsRecordsLowCardinalityOutcomes(t *testing.T) {
+	t.Parallel()
+
+	metrics := NewDokployDependencyMetrics()
+	ctx := WithCorrelation(contextWithFields(t), Correlation{
