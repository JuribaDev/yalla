+			ErrorCode:   errorCode,
+			Retryable:   event.Retryable,
+		}}
+		m.series[key] = series
+	}
+	series.Count++
+	series.TotalLatencyMS += latencyMS
+	series.LastLatencyMS = latencyMS
+	series.RequestID = corr.RequestID
+	series.CorrelationID = corr.CorrelationID
