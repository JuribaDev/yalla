+func dokployMetricErrorCode(err error) string {
+	if err == nil {
+		return ""
+	}
+	var ye *yerr.Error
+	if stderrors.As(err, &ye) {
+		return string(ye.Code)
+	}
+	return string(yerr.CodeInternal)
+}
