    21	// It is safe for concurrent use by net/http handlers.
    22	type HTTPMetrics struct {
    23		mu       sync.Mutex
    24		total    int64
    25		requests map[httpMetricKey]*httpMetricSeries
    26	}
    27	
    28	type httpMetricKey struct {
    29		method      string
    30		route       string
    31		statusCode  int
    32		statusClass string
    33	}
    34	
    35	type httpMetricSeries struct {
    36		HTTPRequestMetric
    37	}
    38	
    39	// HTTPMetricsSnapshot is the JSON-serializable operational view exposed to
    40	// operators and tests.
    41	type HTTPMetricsSnapshot struct {
    42		TotalRequests int64               `json:"total_requests"`
    43		Requests      []HTTPRequestMetric `json:"requests"`
    44	}
    45	
    46	// HTTPRequestMetric is one aggregate request-metric series. Method, Route,
    47	// StatusCode, and StatusClass are the stable low-cardinality dimensions.
    48	// RequestID, CorrelationID, OrganizationID, PrincipalID, and Target describe
    49	// only the most recent request that updated the series so operators can join
    50	// aggregates back to structured logs without making those identifiers labels.
    51	type HTTPRequestMetric struct {
    52		Method         string `json:"method"`
    53		Route          string `json:"route"`
    54		StatusCode     int    `json:"status_code"`
    55		StatusClass    string `json:"status_class"`
    56		Count          int64  `json:"count"`
    57		TotalLatencyMS int64  `json:"total_latency_ms"`
    58		ResponseBytes  int64  `json:"response_bytes"`
    59		LastLatencyMS  int64  `json:"last_latency_ms"`
    60		RequestID      string `json:"request_id,omitempty"`
    61		CorrelationID  string `json:"correlation_id,omitempty"`
    62		OrganizationID string `json:"organization_id,omitempty"`
    63		PrincipalID    string `json:"principal_id,omitempty"`
    64		Target         string `json:"target,omitempty"`
    65	}
    66	
    67	// JobQueueEventName is a bounded event dimension for durable-job queue
    68	// telemetry. Keep this closed and low-cardinality; individual job ids live on
    69	// the metric as latest-sample hints, not labels.
    70	type JobQueueEventName string
    71	
    72	const (
    73		// JobQueueEventClaimed records a worker successfully leasing a job.
    74		JobQueueEventClaimed JobQueueEventName = "claimed"
    75		// JobQueueEventCompleted records a worker committing an outcome.
    76		JobQueueEventCompleted JobQueueEventName = "completed"
    77	)
    78	
    79	// JobQueueEvent is one durable-job queue observation. Event, JobType, Status,
    80	// and StatusClass are the intended aggregate dimensions. JobID, request and
    81	// resource identifiers are latest-sample hints for joining to logs and source
    82	// rows during incidents.
    83	type JobQueueEvent struct {
    84		Event          JobQueueEventName
    85		JobType        string
    86		Status         string
    87		StatusClass    string
    88		JobID          string
    89		RequestID      string
    90		CorrelationID  string
    91		OrganizationID string
    92		ProjectID      string
    93		EnvironmentID  string
    94		ServiceID      string
    95		Attempt        int
    96		MaxAttempts    int
    97		NextRunDelayMS int64
    98	}
    99	
   100	// JobQueueMetric is one aggregate durable-job queue series.
   101	type JobQueueMetric struct {
   102		Event          JobQueueEventName `json:"event"`
   103		JobType        string            `json:"job_type"`
   104		Status         string            `json:"status"`
   105		StatusClass    string            `json:"status_class"`
   106		Count          int64             `json:"count"`
   107		JobID          string            `json:"job_id,omitempty"`
   108		RequestID      string            `json:"request_id,omitempty"`
   109		CorrelationID  string            `json:"correlation_id,omitempty"`
   110		OrganizationID string            `json:"organization_id,omitempty"`
   111		ProjectID      string            `json:"project_id,omitempty"`
   112		EnvironmentID  string            `json:"environment_id,omitempty"`
   113		ServiceID      string            `json:"service_id,omitempty"`
   114		Attempt        int               `json:"attempt,omitempty"`
   115		MaxAttempts    int               `json:"max_attempts,omitempty"`
   116		NextRunDelayMS int64             `json:"next_run_delay_ms,omitempty"`
   117	}
   118	
   119	// JobQueueMetricsSnapshot is the JSON-serializable operational view exposed to
   120	// operators, tests, and future metrics endpoints.
   121	type JobQueueMetricsSnapshot struct {
   122		TotalEvents int64            `json:"total_events"`
   123		Series      []JobQueueMetric `json:"series"`
   124	}
   125	
   126	// JobQueueMetrics stores low-cardinality durable-job queue event counters. It
   127	// is safe for concurrent use by workers.
   128	type JobQueueMetrics struct {
   129		mu     sync.Mutex
   130		total  int64
   131		series map[jobQueueMetricKey]*jobQueueMetricSeries
   132	}
   133	
   134	type jobQueueMetricKey struct {
   135		event       JobQueueEventName
   136		jobType     string
   137		status      string
   138		statusClass string
   139	}
   140	
   141	type jobQueueMetricSeries struct {
   142		JobQueueMetric
   143	}
   144	
   145	// NewHTTPMetrics returns an empty HTTP request metrics collector.
   146	func NewHTTPMetrics() *HTTPMetrics {
   147		return &HTTPMetrics{requests: make(map[httpMetricKey]*httpMetricSeries)}
   148	}
   149	
   150	// NewJobQueueMetrics returns an empty durable-job queue metrics collector.
   151	func NewJobQueueMetrics() *JobQueueMetrics {
   152		return &JobQueueMetrics{series: make(map[jobQueueMetricKey]*jobQueueMetricSeries)}
   153	}
   154	
   155	// Snapshot returns a deterministic copy of all request metrics currently held
   156	// by the collector.
   157	func (m *HTTPMetrics) Snapshot() HTTPMetricsSnapshot {
   158		if m == nil {
   159			return HTTPMetricsSnapshot{Requests: []HTTPRequestMetric{}}
   160		}
   161		m.mu.Lock()
   162		defer m.mu.Unlock()
   163	
   164		out := HTTPMetricsSnapshot{
   165			TotalRequests: m.total,
   166			Requests:      make([]HTTPRequestMetric, 0, len(m.requests)),
   167		}
   168		for _, series := range m.requests {
   169			out.Requests = append(out.Requests, series.HTTPRequestMetric)
   170		}
   171		sort.Slice(out.Requests, func(i, j int) bool {
   172			a, b := out.Requests[i], out.Requests[j]
   173			if a.Route != b.Route {
   174				return a.Route < b.Route
   175			}
   176			if a.Method != b.Method {
   177				return a.Method < b.Method
   178			}
   179			return a.StatusCode < b.StatusCode
   180		})

