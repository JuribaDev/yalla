+	if env.Data.CancelledJobID != "job_0123456789abcdefghjkmnpqrs" || env.Data.Job.ID != "job_0123456789abcdefghjkmnpqrs" || env.Data.Job.Status != "cancelled" || env.Data.Job.FinishedAt == nil {
