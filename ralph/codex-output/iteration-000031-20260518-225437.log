+	running := transitionJob(ctx, t, s, repo, orgA.ID, jobA.ID, store.JobStatusRunning, store.JobTransition{
+		LeaseOwner:    "worker-1",
+		LeaseDuration: time.Minute,
+		Now:           time.Date(2026, 5, 18, 12, 0, 0, 0, time.UTC),
