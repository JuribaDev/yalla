+func TestJobReaderCancelJobTenantAndStateGuards(t *testing.T) {
+	t.Parallel()
+	db := testutil.RequireMigratedDB(t)
+	s := newStore(t, db)
+	repo := store.NewJobRepository()
+	reader, err := store.NewJobReader(s)
+	if err != nil {
