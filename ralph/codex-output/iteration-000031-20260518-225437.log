+			ProjectID:      "proj_jobs",
+			EnvironmentID:  "env_jobs",
+			ServiceID:      "svc_jobs",
+			DesiredVersion: 7,
+			IdempotencyKey: "create-service",
+			Status:         store.JobStatusCancelled,
+			MaxAttempts:    20,
+			NextRunAt:      now,
+			ErrorSummary:   "operator cancelled",
+			Payload:        map[string]string{"service_id": "svc_jobs"},
+			RequestID:      "req_original",
