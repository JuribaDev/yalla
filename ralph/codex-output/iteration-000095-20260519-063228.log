+-- Revert deployment metering resources from quota_resource.
+--
+-- This narrows the domain back to the 0052 set. Operators must remove or
+-- migrate rows using deployments, failed_deployments, or build_minutes before
+-- running this down migration.
+
+DO $$
+DECLARE
+    cname text;
+BEGIN
+    SELECT conname
+      INTO cname
+      FROM pg_constraint
+     WHERE contypid = 'quota_resource'::regtype
+       AND contype  = 'c'
+     LIMIT 1;
+    IF cname IS NOT NULL THEN
+        EXECUTE format('ALTER DOMAIN quota_resource DROP CONSTRAINT %I', cname);
+    END IF;
+END;
+$$;
+
+ALTER DOMAIN quota_resource ADD CONSTRAINT quota_resource_check
+    CHECK (VALUE IN (
+        'projects',
+        'environments',
+        'services',
+        'applications',
+        'compose_stacks',
+        'databases',
+        'domains',
+        'preview_environments',
+        'cpu_millicores',
+        'memory_mb',
+        'storage_gb',
+        'backups',
+        'backup_schedules',
+        'api_keys',
+        'members',
+        'concurrent_deployments',
+        'monthly_deployments'
+    ));
diff --git a/internal/controlplane/store/migrate/migrations/0053_build_deployment_metering_resources.up.sql b/internal/controlplane/store/migrate/migrations/0053_build_deployment_metering_resources.up.sql
