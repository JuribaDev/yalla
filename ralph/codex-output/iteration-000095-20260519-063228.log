+type meteringSeed struct {
+	OrganizationID string
+	ProjectID      string
+	EnvironmentID  string
+	ServiceID      string
+}
+
+func newMeteringStore(t *testing.T, db *testutil.DB) *store.Store {
+	t.Helper()
+	s, err := store.New(db.Pool, nil)
+	if err != nil {
+		t.Fatalf("store.New: %v", err)
+	}
+	return s
+}
