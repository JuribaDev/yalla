index 0000000000000000000000000000000000000000..ab99080cbb8b53d5017a27a9c1dc7115a686a159
--- /dev/null
+++ b/internal/controlplane/store/migrate/migrations/0053_build_deployment_metering_resources.down.sql
@@ -0,0 +1,42 @@
+-- Revert deployment metering resources from quota_resource.
+--
+-- This narrows the domain back to the 0052 set. Operators must remove or
+-- migrate rows using deployments, failed_deployments, or build_minutes before
+-- running this down migration.
+
+DO $$
+DECLARE
+    cname text;
+BEGIN
+    SELECT conname
+      INTO cname
+      FROM pg_constraint
+     WHERE contypid = 'quota_resource'::regtype
+       AND contype  = 'c'
+     LIMIT 1;
+    IF cname IS NOT NULL THEN
+        EXECUTE format('ALTER DOMAIN quota_resource DROP CONSTRAINT %I', cname);
+    END IF;
+END;
+$$;
+
+ALTER DOMAIN quota_resource ADD CONSTRAINT quota_resource_check
+    CHECK (VALUE IN (
+        'projects',
+        'environments',
+        'services',
+        'applications',
+        'compose_stacks',
+        'databases',
+        'domains',
+        'preview_environments',
+        'cpu_millicores',
+        'memory_mb',
+        'storage_gb',
+        'backups',
+        'backup_schedules',
+        'api_keys',
+        'members',
+        'concurrent_deployments',
+        'monthly_deployments'
+    ));
diff --git a/internal/controlplane/store/migrate/migrations/0053_build_deployment_metering_resources.up.sql b/internal/controlplane/store/migrate/migrations/0053_build_deployment_metering_resources.up.sql
new file mode 100644
index 0000000000000000000000000000000000000000..83127708113c7219fc18a258b45031409da640f6
--- /dev/null
+++ b/internal/controlplane/store/migrate/migrations/0053_build_deployment_metering_resources.up.sql
@@ -0,0 +1,47 @@
+-- Add billing-grade deployment metering resources to quota_resource.
+--
+-- deployments is the successful deployment counter emitted from Yalla's
+-- deployment_events timeline. failed_deployments is the failure counter so
+-- pricing entitlements can distinguish failed deploy attempts from successful
+-- deploys. build_minutes is the duration dimension emitted from worker job
+-- timestamps and job_attempts rows.
+
+DO $$
+DECLARE
+    cname text;
+BEGIN
+    SELECT conname
+      INTO cname
+      FROM pg_constraint
+     WHERE contypid = 'quota_resource'::regtype
+       AND contype  = 'c'
+     LIMIT 1;
+    IF cname IS NOT NULL THEN
+        EXECUTE format('ALTER DOMAIN quota_resource DROP CONSTRAINT %I', cname);
+    END IF;
+END;
+$$;
+
+ALTER DOMAIN quota_resource ADD CONSTRAINT quota_resource_check
+    CHECK (VALUE IN (
+        'projects',
+        'environments',
+        'services',
+        'applications',
+        'compose_stacks',
+        'databases',
+        'domains',
+        'preview_environments',
+        'cpu_millicores',
+        'memory_mb',
+        'storage_gb',
+        'backups',
+        'backup_schedules',
+        'api_keys',
+        'members',
+        'concurrent_deployments',
+        'monthly_deployments',
+        'deployments',
+        'failed_deployments',
+        'build_minutes'
+    ));
