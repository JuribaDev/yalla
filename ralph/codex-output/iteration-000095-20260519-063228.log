+	if _, err := db.Exec(ctx, `INSERT INTO environments (id, organization_id, project_id, slug, display_name, kind, status) VALUES ($1, $2, $3, $4, $5, 'production', 'active')`, env.ID, org.ID, project.ID, env.Slug, env.Name); err != nil {
