		`INSERT INTO environments (id, organization_id, project_id, slug, display_name, kind)
		 VALUES ($1, $2, $3, $4, $5, $6)
		 RETURNING `+environmentColumns,
		e.ID, e.OrganizationID, e.ProjectID, e.Slug, e.DisplayName, e.Kind)
