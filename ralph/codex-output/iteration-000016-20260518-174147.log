+			OrganizationID:  job.OrganizationID,
+			YallaKind:       store.YallaKindService,
+			YallaID:         payload.ServiceID,
+			DokployResource: store.DokployResourceDatabase,
+			DokployID:       dokployID,
+		})
+		if err != nil {
+			return err
+		}
+		return nil
+	})
+}
