//   - `-s -w` — drops the symbol and DWARF tables. Smaller image,
//     fewer reverse-engineering hand-holds.
var requiredBuilderBuildFlags = []string{
	"CGO_ENABLED=0",
	"-trimpath",
	"-s -w",
}

