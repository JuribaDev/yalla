+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 65532
+        runAsGroup: 65532
+        fsGroup: 65532
+        fsGroupChangePolicy: OnRootMismatch
+        seccompProfile:
+          type: RuntimeDefault
+      containers:
+        - name: yalla-worker
+          image: ghcr.io/juribadev/yalla-worker:0.0.0-dev
+          imagePullPolicy: IfNotPresent
+          command:
+            - /usr/local/bin/yalla-worker
+          env:
+            - name: YALLA_PROFILE
+              valueFrom:
+                configMapKeyRef:
+                  name: yalla-control-plane-config
+                  key: YALLA_PROFILE
+            - name: YALLA_LOG_LEVEL
+              valueFrom:
+                configMapKeyRef:
+                  name: yalla-control-plane-config
+                  key: YALLA_LOG_LEVEL
+            - name: YALLA_DATABASE_URL
+              valueFrom:
+                secretKeyRef:
+                  name: yalla-control-plane-secrets
+                  key: YALLA_DATABASE_URL
+            - name: YALLA_DOKPLOY_BASE_URL
+              valueFrom:
+                secretKeyRef:
+                  name: yalla-control-plane-secrets
+                  key: YALLA_DOKPLOY_BASE_URL
+            - name: YALLA_DOKPLOY_TOKEN
+              valueFrom:
+                secretKeyRef:
+                  name: yalla-control-plane-secrets
+                  key: YALLA_DOKPLOY_TOKEN
+          resources:
+            requests:
+              cpu: 100m
+              memory: 128Mi
+            limits:
+              cpu: 500m
+              memory: 512Mi
+          securityContext:
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities:
+              drop:
+                - ALL
+          volumeMounts:
+            - name: tmp
+              mountPath: /tmp
+      volumes:
+        - name: tmp
+          emptyDir:
+            medium: Memory
+            sizeLimit: 64Mi
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: yalla-api
+  namespace: yalla-control-plane
+  labels:
+    app.kubernetes.io/name: yalla-api
+    app.kubernetes.io/component: api
+    app.kubernetes.io/part-of: yalla
+spec:
+  type: ClusterIP
+  selector:
+    app.kubernetes.io/name: yalla-api
+    app.kubernetes.io/component: api
+  ports:
+    - name: http
+      port: 8080
+      targetPort: http
+      protocol: TCP
+---
+apiVersion: policy/v1
+kind: PodDisruptionBudget
+metadata:
+  name: yalla-api
+  namespace: yalla-control-plane
+  labels:
+    app.kubernetes.io/name: yalla-api
+    app.kubernetes.io/component: api
+    app.kubernetes.io/part-of: yalla
+spec:
+  minAvailable: 1
