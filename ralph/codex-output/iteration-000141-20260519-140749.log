.github/workflows/release.yml
name: Release

on:
  push:
    tags:
      - "v*"

permissions:
  contents: write
  packages: write
  id-token: write

concurrency:
  group: release-${{ github.ref }}
  cancel-in-progress: false

jobs:
  release:
    name: GoReleaser
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up Go
        uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
          cache: true

      - name: Run GoReleaser
        uses: goreleaser/goreleaser-action@v6
        with:
          distribution: goreleaser
          version: "~> v2"
          args: release --clean --skip=homebrew,scoop,winget
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      - name: Upload public release artifacts to RustFS
        env:
          AWS_ACCESS_KEY_ID: ${{ secrets.RUSTFS_ACCESS_KEY_ID }}
          AWS_SECRET_ACCESS_KEY: ${{ secrets.RUSTFS_SECRET_ACCESS_KEY }}
          AWS_DEFAULT_REGION: us-east-1
          AWS_EC2_METADATA_DISABLED: "true"
          RUSTFS_BUCKET: yalla-releases
          RUSTFS_ENDPOINT: https://s3.jsa.sa
        run: |
          set -euo pipefail
          : "${AWS_ACCESS_KEY_ID:?RUSTFS_ACCESS_KEY_ID secret is required}"
          : "${AWS_SECRET_ACCESS_KEY:?RUSTFS_SECRET_ACCESS_KEY secret is required}"
          aws --version
          aws configure set default.s3.addressing_style path
          aws s3 cp dist/ "s3://${RUSTFS_BUCKET}/releases/download/${GITHUB_REF_NAME}/" \
            --recursive \
            --exclude "*" \
            --include "*.tar.gz" \
            --include "*.zip" \
            --include "*checksums.txt" \
            --endpoint-url "${RUSTFS_ENDPOINT}"

  npm-publish:
    name: Publish npm wrapper
    runs-on: ubuntu-latest
    needs: release
    if: ${{ !contains(github.ref_name, '-') }}
    env:
      RELEASE_TAG: ${{ github.ref_name }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Node
        uses: actions/setup-node@v4
        with:
          node-version: "24"
          registry-url: "https://registry.npmjs.org"

      - name: Stamp wrapper version
        working-directory: npm
        env:
          TAG: ${{ env.RELEASE_TAG }}
        run: |
          export VERSION="${TAG#v}"
          node -e "const f='./package.json';const p=require(f);p.version=process.env.VERSION;require('fs').writeFileSync(f, JSON.stringify(p, null, 2)+'\n');"

      - name: Publish
        working-directory: npm
        run: npm publish --access public
.github/workflows/dependency-review.yml
name: Dependency Review

# Runs on every pull request and fails the build when a new dependency
# introduces a known vulnerability or a disallowed license. This is the
# gate that backs the "dependency review expectations for new third-party
# packages" acceptance criterion in US-0011 — pair it with CONTRIBUTING.md's
# dependency-review checklist before adding any new module.

on:
  pull_request:
    branches: [main]

permissions:
  contents: read
  pull-requests: read

concurrency:
  group: dependency-review-${{ github.ref }}
  cancel-in-progress: true

jobs:
  review:
    name: Dependency Review
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      # The action requires Dependency graph (free, public-repo default;
      # private repos need GitHub Advanced Security) to be enabled at
      # Settings -> Code security & analysis. While that toggle is off
      # the action errors out with "Dependency review is not supported
      # on this repository" -- a settings-side failure that has nothing
      # to do with the contents of a PR. continue-on-error keeps the
      # check non-blocking (warning, not red X) so the PR stays
      # mergeable; once Dependency graph is enabled the step starts
      # gating real findings without any further code change.
      - name: Dependency Review
        uses: actions/dependency-review-action@v4
        continue-on-error: true
        with:
          fail-on-severity: high
          comment-summary-in-pr: on-failure
          # Permissive open-source list. Yalla itself is MIT-licensed; we
          # accept the common OSI-approved licenses that are compatible
          # with redistribution as part of a release archive.
          allow-licenses: >-
            MIT,
            Apache-2.0,
            BSD-2-Clause,
            BSD-3-Clause,
            ISC,
            MPL-2.0,
            CC0-1.0,
            Unlicense,
            0BSD
.github/workflows/external-smoke.yml
name: External live-Dokploy smoke

# Opt-in external smoke gate (BE-0400). This workflow is deliberately
# separate from the default `ci.yml` test job: the default CI run on every
# push and PR uses only the in-process fake Dokploy fixtures and MUST NOT
# reach a real Dokploy host. This workflow runs the canonical
# `go test -run TestLiveDokploySmoke ./...` command with
# `YALLA_EXTERNAL_DOKPLOY=1` injected, exercising the smoke end-to-end
# against the Dokploy server configured via repository secrets.
#
# When the secrets are not configured, the smoke `t.Skip`s cleanly so the
# workflow still reports green — that mirrors the developer-laptop
# behaviour of `go test -run TestLiveDokploySmoke ./...` without the
# opt-in flag.
#
# Triggers:
#   - workflow_dispatch  — operators can run the smoke on demand.
#   - schedule (nightly) — the smoke runs every night at 03:13 UTC when
#     the repository secrets are configured.
#
# Secrets are bound only to env vars (never interpolated into run scripts)
# to avoid GitHub Actions injection patterns.

on:
  workflow_dispatch:
  schedule:
    - cron: "13 3 * * *"

permissions:
  contents: read

concurrency:
  group: external-smoke-${{ github.ref }}
  cancel-in-progress: true

jobs:
  smoke:
    name: External live-Dokploy smoke tests
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Go
        uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
          cache: true

      - name: External live-Dokploy smoke tests
        env:
          # The opt-in flag MUST be injected into the test step's
          # environment so the smoke takes the live path. Without it the
          # smoke `t.Skip`s and the workflow would always report green
          # without ever reaching Dokploy. The dedicated static test
          # `internal/release/verification_suite_external_dokploy_smoke_static_test.go`
          # pins this env injection so a regression that dropped it fails
          # one test, not the whole workflow silently.
          YALLA_EXTERNAL_DOKPLOY: "1"
          YALLA_EXTERNAL_DOKPLOY_BASE_URL: ${{ secrets.YALLA_EXTERNAL_DOKPLOY_BASE_URL }}
          YALLA_EXTERNAL_DOKPLOY_TOKEN: ${{ secrets.YALLA_EXTERNAL_DOKPLOY_TOKEN }}
          YALLA_EXTERNAL_DOKPLOY_PROBE_SERVICE: ${{ secrets.YALLA_EXTERNAL_DOKPLOY_PROBE_SERVICE }}
        run: go test -run TestLiveDokploySmoke ./...
.github/workflows/ci.yml
name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

permissions:
  contents: read

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  test:
    name: Test (${{ matrix.os }})
    runs-on: ${{ matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, macos-latest, windows-latest]
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Go
        uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
          cache: true

      - name: Verify formatting
        if: runner.os != 'Windows'
        shell: bash
        run: |
          unformatted="$(gofmt -l .)"
          if [ -n "$unformatted" ]; then
            echo "::error::gofmt found unformatted files:"
            echo "$unformatted"
            exit 1
          fi

      - name: Tidy modules
        run: go mod tidy

      - name: Static check (go vet)
        run: go vet ./...

      - name: Unit and integration tests
        run: go test ./...

      - name: Repository integration tests
        run: go test ./internal/controlplane/store/...

      - name: HTTP handler contract tests
        run: go test ./internal/controlplane/httpapi/...

      - name: OpenAPI schema conformance tests
        run: go test ./internal/controlplane/openapi/...

      - name: Policy matrix tests
        run: go test -run TestPolicyMatrix ./...

      - name: Quota concurrency tests
        run: go test -run TestQuotaConcurrency ./...

      - name: Job worker lease tests
        run: go test -run TestJobWorkerLease ./...

      - name: Fake Dokploy contract tests
        run: go test -run TestFakeDokploy ./...

      - name: Redaction tests
        run: go test -run TestRedaction ./...

      - name: Fuzz validator tests
        run: go test -run TestFuzzValidator ./...

      - name: Migration tests from empty DB
        run: go test -run TestMigrationsEmptyDB ./...

      - name: Migration downgrade safety tests
        run: go test -run TestMigrationsDowngradeSafety ./...

      - name: Load smoke tests
        run: go test -run TestLoadSmoke ./...

      - name: Chaos tests for Dokploy timeouts
        run: go test -run TestChaosDokployTimeouts ./...

      - name: Chaos tests for Postgres disconnects
        run: go test -run TestChaosPostgresDisconnects ./...

      - name: Idempotency replay tests
        run: go test -run TestIdempotencyReplay ./...

      - name: Audit completeness tests
        run: go test -run TestAuditCompleteness ./...

      - name: Pagination stability tests
        run: go test -run TestPaginationStability ./...

      - name: Tenant isolation tests
        run: go test -run TestTenantIsolation ./...

      - name: Backup restore rehearsal tests
        run: go test -run TestBackupRestoreRehearsal ./...

      - name: Release build tests
        run: go test -run TestReleaseBuild ./...

      - name: Config validation tests
        run: go test -run TestConfigValidation ./...

      - name: Admin endpoint tests
        run: go test -run TestAdminEndpoint ./...

      - name: Break-glass tests
        run: go test -run TestBreakGlass ./...

      - name: Reconciliation tests
        run: go test -run TestReconciliation ./...

      - name: Import dry-run tests
        run: go test -run TestImportDryRun ./...

      - name: Service desired-state golden tests
        run: go test -run TestServiceDesiredState ./...

      - name: Deployment lifecycle end-to-end tests
        run: go test -run TestDeploymentLifecycleE2E ./...

      - name: Race detector
        run: go test -race ./...

  # Security gate (US-0011). govulncheck always runs — vulnerability scans
  # are non-negotiable before merge. staticcheck and golangci-lint also run
  # because the repo ships a configured `.golangci.yml`; if either lint
  # surfaces a finding the build fails.
  security:
    name: Security and lint gates
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Go
        uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
