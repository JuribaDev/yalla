+				"go test ./internal/release/... -run TestPolicyEngineConventionsArtifact",
+			},
+		},
+	} {
+		body := readTextFile(t, filepath.Join(root, tc.path))
+		for _, want := range tc.want {
+			if !strings.Contains(body, want) {
+				t.Fatalf("%s missing %q", tc.path, want)
+			}
+		}
+	}
+}
