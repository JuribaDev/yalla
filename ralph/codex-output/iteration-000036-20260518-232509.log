+		t.Errorf("operationId = %q, want reconcileAdminDokploy", op.OperationID)
+	}
+	if op.RequiredAction != string(policy.ActionAdminReconcile) {
+		t.Errorf("required action = %q, want %q", op.RequiredAction, policy.ActionAdminReconcile)
