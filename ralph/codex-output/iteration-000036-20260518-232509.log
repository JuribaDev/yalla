+func (f *fakeAdminDokployReconciler) ReconcileDokploy(ctx context.Context, req AdminDokployReconcileRequest) (AdminDokployReconcileResult, error) {
+	f.calls++
+	f.got = req
+	if f.err != nil {
+		return AdminDokployReconcileResult{}, f.err
+	}
+	return f.result, nil
+}
