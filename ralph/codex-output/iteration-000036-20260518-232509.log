+			OperationID    string           `json:"operationId"`
+			RequiredAction string           `json:"x-required-action"`
+			Security       []map[string]any `json:"security"`
+		} `json:"paths"`
+	}
+	if err := json.Unmarshal(rec.Body.Bytes(), &doc); err != nil {
+		t.Fatalf("decode openapi: %v", err)
