  "pricingAndUsageTracking": {
    "strategy": "Start with quota-enforced plans plus append-only usage events and period counters. Hard-limit countable resources immediately; meter growth-sensitive traffic and infrastructure usage before billing or overage enforcement becomes strict.",
    "pricingModel": {
      "planCatalog": [
        "starter",
        "pro",
        "business",
        "enterprise"
      ],
      "concepts": [
        "plans define default packages",
        "plan_entitlements define included usage and hard/soft limits",
        "subscriptions attach an organization to a plan and billing period",
        "subscription_entitlements override plan defaults for add-ons, migrations, and enterprise contracts",
        "usage_events record what happened over time",
        "usage_counters aggregate billing-period totals",
        "quota_reservations prevent concurrent over-allocation before provisioning completes",
        "billing_exports send accepted metered usage to Stripe or a manual invoicing adapter later"
      ],
      "enforcementModes": [
        "hard",
        "soft",
        "metered",
        "disabled"
      ],
      "examplePlans": {
        "starter": {
          "target": "small projects and trials",
          "hardLimits": {
            "projects": 3,
            "environments_per_project": 2,
            "services": 5,
            "databases": 1,
            "domains": 3,
            "api_keys": 3,
            "members": 3,
            "concurrent_deployments": 1
          },
          "includedMeteredUsage": {
            "monthly_deployments": 100,
            "backup_storage_gb_month": 1
          }
        },
        "pro": {
          "target": "growing teams",
          "hardLimits": {
            "projects": 10,
            "environments_per_project": 5,
            "services": 25,
            "databases": 5,
            "domains": 20,
            "api_keys": 10,
            "members": 10,
            "concurrent_deployments": 3
          },
          "includedMeteredUsage": {
            "monthly_deployments": 1000,
            "backup_storage_gb_month": 50,
            "preview_environments": 10
          }
        },
        "business": {
          "target": "agencies and production teams",
          "hardLimits": {
            "projects": 50,
            "services": 200,
            "databases": 25,
            "domains": 100,
            "api_keys": 50,
            "members": 50,
            "concurrent_deployments": 10
          },
          "includedMeteredUsage": {
            "monthly_deployments": 10000,
            "backup_storage_gb_month": 500,
            "preview_environments": 100,
            "audit_retention_days": 365
          }
        },
        "enterprise": {
          "target": "custom contracts",
          "hardLimits": "custom",
          "includedMeteredUsage": "custom",
          "features": [
            "SSO",
            "custom roles",
            "custom audit retention",
            "dedicated Dokploy organization or instance option",
            "SLA/support contract"
          ]
        }
      }
    },
    "meteringSources": {
      "dokploy": {
        "role": "Operational input for server/container/app metrics where available; not treated as the only billing source of truth.",
        "examples": [
          "application.readAppMonitoring",
          "user.getContainerMetrics",
          "server.getServerMetrics",
          "user.getServerMetrics"
        ]
      },
      "traefik": {
        "role": "Primary HTTP traffic source for RPS, request count, status-code counts, latency, and bandwidth attribution.",
        "metrics": [
          "traefik_service_requests_total",
          "traefik_service_request_duration_seconds",
          "traefik_service_requests_bytes_total",
          "traefik_service_responses_bytes_total"
        ]
      },
      "yallaEvents": {
        "role": "Authoritative product events for deployments, build minutes, resource lifecycle, reservations, and billing-period counters.",
        "examples": [
          "deployment.created",
          "deployment.completed",
          "service.created",
          "service.deleted",
          "backup.completed",
          "quota.reserved",
          "quota.consumed"
        ]
      },
      "infrastructureCollectors": {
        "role": "Storage and container-resource source when Dokploy metrics are insufficient.",
        "examples": [
          "Docker stats or cAdvisor for CPU/RAM",
          "node exporter or volume scanner for disk and volume usage"
        ]
      }
    },
    "attributionRules": [
      "Yalla controls Dokploy app/service names and must include stable service IDs such as yalla-svc_456 where possible.",
      "Metrics are attributed by mapping Traefik service labels or Dokploy app names to dokploy_refs, then to service, environment, project, and organization.",
      "Every aggregated usage counter must be org-scoped and include the source, period, unit, and aggregation version.",
      "Billing-grade counters must be derived from append-only usage_events or reproducible metric windows, never from mutable current state alone.",
      "Current resource state is still used for real-time quota checks such as active services, active databases, domains, and members."
    ],
    "trackedMetrics": [
      {
        "key": "http_requests",
        "unit": "request",
        "source": "traefik",
        "enforcement": "metered",
        "billingGrade": true
      },
      {
        "key": "http_rps_peak_1m",
