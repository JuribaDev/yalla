    "immediateEnforcement": {
      "hardBlock": [
        "projects",
        "environments",
        "services",
        "databases",
        "domains",
        "members",
        "api_keys",
        "concurrent_deployments"
      ],
      "warnOrMeterFirst": [
        "monthly_deployments",
