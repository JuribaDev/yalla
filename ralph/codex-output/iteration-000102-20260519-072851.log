        "enforcement": "metered",
        "billingGrade": true
      },
      {
        "key": "deployments",
        "unit": "deployment",
        "source": "yalla_events",
        "enforcement": "hard_or_metered",
        "billingGrade": true
      },
      {
        "key": "active_services",
