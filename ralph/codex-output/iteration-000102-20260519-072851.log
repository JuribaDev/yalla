        "source": "traefik",
        "enforcement": "metered",
        "billingGrade": true
      },
      {
        "key": "http_bandwidth_total",
        "unit": "byte",
        "source": "traefik",
        "enforcement": "metered",
        "billingGrade": true
      },
      {
        "key": "http_5xx_count",
        "unit": "response",
        "source": "traefik",
        "enforcement": "observability",
        "billingGrade": false
      },
      {
        "key": "latency_p95_ms",
        "unit": "millisecond",
        "source": "traefik",
        "enforcement": "observability",
        "billingGrade": false
      },
      {
        "key": "container_cpu_millicore_seconds",
