+func TestContainerCPUMillicoreSecondsMetricDefinition(t *testing.T) {
+	t.Parallel()
+
+	def, ok := LookupMetricDefinition("container_cpu_millicore_seconds")
+	if !ok {
+		t.Fatal("LookupMetricDefinition(container_cpu_millicore_seconds) missing")
