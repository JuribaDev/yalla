+func TestUsageReaderIncludesContainerCPUCountersForCurrentPeriod(t *testing.T) {
+	t.Parallel()
+	db := testutil.RequireMigratedDB(t)
+	s := newStore(t, db)
+	pricing := store.NewPricingPlanRepository()
+	subs := store.NewSubscriptionRepository()
+	counters := store.NewUsageCounterRepository()
+	events := store.NewUsageEventRepository()
+	f := testutil.NewFactory(t)
+	ctx := context.Background()
+	now := time.Now().UTC().Truncate(time.Second)
+
+	org := seedOrg(t, db, f, "ContainerCPUUsage")
+	plan := seededPlan(ctx, t, s, pricing, "business-container-cpu")
+	sub := createSubscriptionOrFail(ctx, t, s, subs, baseSubscriptionInput(org.ID, plan.ID, store.SubscriptionStatusActive, now))
+	upsertSubscriptionEntitlementOrFail(ctx, t, s, subs,
+		baseOverrideInput(org.ID, sub.ID, "container_cpu_millicore_seconds", store.EntitlementSourceSubscriptionOverride, 100000, now))
+
+	appendUsageEventOrFail(ctx, t, s, events, store.AppendUsageEventInput{
+		OrganizationID: org.ID,
+		Resource:       store.QuotaResourceContainerCPUMillicoreSeconds,
+		EventType:      store.UsageEventTypeConsumed,
+		Quantity:       1250,
+		Unit:           "millicore_second",
+		Source:         "dokploy_or_cadvisor",
+		IdempotencyKey: "container_cpu:test-window",
+		OccurredAt:     now,
+	})
+	aggregateUsageCountersOrFail(ctx, t, s, counters, store.AggregateUsageCountersInput{
+		OrganizationID:     org.ID,
+		PeriodStart:        now.Add(-time.Hour),
+		PeriodEnd:          now.Add(time.Hour),
+		AggregatedAt:       now,
+		AggregationVersion: 1,
+	})
+
+	reader, err := store.NewUsageReader(s, nil)
+	if err != nil {
+		t.Fatalf("NewUsageReader: %v", err)
+	}
+	got, err := reader.ListOrganizationUsage(ctx, org.ID)
+	if err != nil {
+		t.Fatalf("ListOrganizationUsage: %v", err)
+	}
+	var cpu store.OrganizationResourceUsage
+	for _, row := range got {
+		if row.Resource == store.QuotaResourceContainerCPUMillicoreSeconds {
+			cpu = row
+			break
+		}
+	}
+	if cpu.Resource == "" {
+		t.Fatalf("usage rows %+v missing container_cpu_millicore_seconds counter", got)
+	}
+	if cpu.UsedValue != 1250 {
+		t.Fatalf("container_cpu_millicore_seconds UsedValue = %d, want aggregated counter 1250", cpu.UsedValue)
+	}
+	if cpu.LimitValue == nil || *cpu.LimitValue != 100000 {
+		t.Fatalf("container_cpu_millicore_seconds limit = %+v, want subscription entitlement 100000", cpu)
+	}
+}
+
 // TestNewUsageReaderRejectsNilStore proves a misconfigured reader fails at
 // construction rather than on its first request.
 func TestNewUsageReaderRejectsNilStore(t *testing.T) {
diff --git a/ralph/progress.txt b/ralph/progress.txt
index b234df2e334320c274ffa54034c7c0f86858d0c5..caaf2386a23ac5a4fb8483816bd339b0bbd54d48
--- a/ralph/progress.txt
+++ b/ralph/progress.txt
@@ -1,4 +1,5 @@
 ## Codebase Patterns
+- Billing-grade container metric stories follow the same four-piece tracked-metric vertical as Traefik/build metering: add a runtime `metering.MetricDefinition`, extend the closed `quota_resource` domain plus `store.QuotaResource`, quarantine samples before billing unless attribution resolves a full org/project/environment/service scope, and emit idempotent `usage_events` whose current-period aggregation is visible through the organization usage projection.
 - HTTP request metrics live in `internal/controlplane/telemetry` and are wired by `httpapi.NewHandler` inside request logging: group metric series only by method, normalized route, status code, and status class; keep request/correlation/org/principal identifiers as latest-sample log-join hints instead of dashboard labels.
 - Billing-grade Traefik metric stories should add four pieces together: a runtime `metering.MetricDefinition`, a new `quota_resource` migration + `store.QuotaResource` constant when the key is invoiceable, an idempotent emitter that writes only fully attributed samples into `usage_events`, and a customer usage projection from current-period `usage_counters`.
 - Entitlement-backed hard quota rejections should carry both human guidance and stable machine details: `resource`, `entitlement_key`, `current`, `reserved`, `requested`, `limit`, and subscription `reset_period_start`/`reset_period_end` when the limit came from a current subscription period. Keep the detailed counts from the same locked quota decision that creates or rejects the reservation.

