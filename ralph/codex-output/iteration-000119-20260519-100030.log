--- /dev/null
+++ b/internal/controlplane/httpapi/admin_metric_definitions_test.go
@@ -0,0 +1,218 @@
+package httpapi
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
