diff --git a/internal/controlplane/httpapi/admin_metric_definitions.go b/internal/controlplane/httpapi/admin_metric_definitions.go
new file mode 100644
index 0000000000000000000000000000000000000000..fe085bcf5c6bdf4e974bb51927eefef0c458bd94
