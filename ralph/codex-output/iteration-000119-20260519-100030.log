diff --git a/internal/controlplane/store/migrate/migrations/0064_admin_metric_definitions.up.sql b/internal/controlplane/store/migrate/migrations/0064_admin_metric_definitions.up.sql
new file mode 100644
index 0000000000000000000000000000000000000000..18d81163dc4ffae70e5e2cff4a59bf11de7752e9
--- /dev/null
+++ b/internal/controlplane/store/migrate/migrations/0064_admin_metric_definitions.up.sql
@@ -0,0 +1,41 @@
+-- Backoffice metric definition configuration. Rows are global operator-owned
+-- runtime contracts; billing-grade unit changes are versioned instead of
+-- mutating historical definitions in place.
+
+CREATE DOMAIN metric_aggregation_function AS text
+    CHECK (VALUE IN ('sum', 'max', 'avg', 'p95', 'last'));
+
+CREATE TABLE admin_metric_definitions (
+    id                         text                         PRIMARY KEY CHECK (length(id) > 0),
+    metric_key                 citext                       NOT NULL CHECK (metric_key ~ '^[a-z0-9][a-z0-9_]{0,127}$'),
+    version                    integer                      NOT NULL CHECK (version > 0),
+    unit                       text                         NOT NULL CHECK (unit ~ '^[a-z0-9][a-z0-9_]{0,63}$'),
+    source                     text                         NOT NULL CHECK (source ~ '^[a-z0-9][a-z0-9_]{0,127}$'),
+    aggregation_function       metric_aggregation_function  NOT NULL,
+    aggregation_window_seconds integer                      NOT NULL CHECK (aggregation_window_seconds BETWEEN 1 AND 2678400),
+    billing_grade              boolean                      NOT NULL DEFAULT false,
+    retention_days             integer                      NOT NULL CHECK (retention_days BETWEEN 1 AND 3650),
+    enforcement_link           text                         NOT NULL DEFAULT '' CHECK (length(enforcement_link) <= 160),
+    enabled                    boolean                      NOT NULL DEFAULT true,
+    revision                   bigint                       NOT NULL DEFAULT 1 CHECK (revision > 0),
+    published_at               timestamptz                  NOT NULL DEFAULT now(),
+    superseded_at              timestamptz,
+    created_at                 timestamptz                  NOT NULL DEFAULT now(),
+    updated_at                 timestamptz                  NOT NULL DEFAULT now(),
+    UNIQUE (metric_key, version),
+    CONSTRAINT admin_metric_definitions_enforcement_link_token CHECK (
+        enforcement_link = '' OR enforcement_link ~ '^[a-z0-9][a-z0-9_.-]{0,159}$'
+    )
+);
+
+CREATE INDEX admin_metric_definitions_runtime_idx
+    ON admin_metric_definitions (enabled, source, metric_key)
+    WHERE superseded_at IS NULL;
+
+CREATE UNIQUE INDEX admin_metric_definitions_current_unique
+    ON admin_metric_definitions (metric_key)
+    WHERE superseded_at IS NULL;
+
+CREATE TRIGGER admin_metric_definitions_set_updated_at
+    BEFORE UPDATE ON admin_metric_definitions
+    FOR EACH ROW EXECUTE FUNCTION set_updated_at();
diff --git a/ralph/progress.txt b/ralph/progress.txt
index a7536d05b4d28c6671b0120634cfb6dda33bd442..f6b004f1bc737001d4ddf6b792aaf74f3dc95493
--- a/ralph/progress.txt
+++ b/ralph/progress.txt
@@ -1,4 +1,5 @@
 ## Codebase Patterns
+- Backoffice metric definitions use dedicated versioned global config, not generic JSON config: `admin_metric_definitions` keeps one current row per key (`superseded_at IS NULL`), `MetricDefinitionRepository.Upsert` rejects billing-grade unit changes unless `AllowNewVersion` is set and then inserts the next version, runtime aggregators reload enabled current rows through `ListRuntimePublished`, and HTTP routes are support-gated with `admin.metering.manage`.
 - Backoffice metering source configuration uses a dedicated audited store surface rather than generic JSON config when credentials are involved: persist global `admin_metering_sources` rows with write-only `(credential_provider, credential_key_id, credential_ciphertext)` columns, return only `credential_set` on the wire, expose runtime reload through `MeteringSourceRepository.ListRuntimeEnabled`, and gate HTTP routes with `admin.metering.manage` (currently CapSupport).
 - Quota usage metrics follow the existing HTTP/job/Dokploy collector pattern: one in-memory `telemetry.QuotaUsageMetrics` series per low-cardinality `(resource, enforcement_mode, outcome, reason)` tuple, with request/correlation/org/principal/job IDs and quota counts kept only as latest-sample incident hints. The quota checker emits decisions for allowed, rejected, validation, and infrastructure-error paths, and `/metrics` exposes the snapshot under `data.quota_usage`.
 - Dokploy dependency metrics follow the existing HTTP/job queue collector pattern: one in-memory `telemetry.DokployDependencyMetrics` series per low-cardinality `(method, normalized_endpoint, outcome, status_class, error_code, retryable)` tuple; request/correlation/org/project/env/service/principal/job identifiers are latest-sample hints only. The typed Dokploy client emits one event per actual HTTP attempt after local validation, and `/metrics` exposes the snapshot under `data.dokploy_dependencies`.

