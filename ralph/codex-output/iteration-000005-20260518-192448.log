	if v := requireFields(field{"project_id", in.ProjectID}); v != nil {
		return v
	}
	err := c.del(ctx, "/api/projects/"+url.PathEscape(strings.TrimSpace(in.ProjectID)))
	if err == nil {
		return nil
	}
	var ye *yerr.Error
	if stderrors.As(err, &ye) && ye.Code == yerr.CodeNotFound {
		return nil
	}
	return err
}

