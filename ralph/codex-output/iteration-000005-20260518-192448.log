+		refs, err = repo.ListByYallaResource(ctx, q, organizationID, store.YallaKindServiceDomain, domainID)
+		return err
+	}); err != nil {
+		t.Fatalf("list service domain dokploy refs: %v", err)
+	}
+	return refs
+}

