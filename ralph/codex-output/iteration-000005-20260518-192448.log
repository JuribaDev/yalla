+  - `go mod tidy`
+  - `go test ./internal/controlplane/worker -run 'TestProvisionerSyncDomains|TestSyncDomains' -count=1`
+  - `go test ./internal/controlplane/store/migrate -run TestMigrations -count=1`
+  - `go test ./internal/controlplane/worker -count=1`
+  - `go test ./...`
+  - `go test -race ./...`
+  - `go vet ./...`
+  - `go test ./internal/controlplane/...`
