		ref.DokployResource.String(), ref.DokployID)
	inserted, err := scanDokployRef(row)
	if err != nil {
		return DokployRef{}, mapWriteError(err, "a dokploy mapping with this yalla resource, dokploy resource, or dokploy id already exists")
	}
	return inserted, nil
