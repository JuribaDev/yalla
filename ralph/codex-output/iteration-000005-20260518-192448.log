349-
350-// ListServiceDomainsInput is the typed input shape
351-// ServiceDomainReader.ListDomains accepts. OrganizationID is always
352-// taken from the authenticated principal's home org at the httpapi
353-// layer (never from caller-controlled request input), and ServiceID
354-// is always taken from the path parameter; both surface here as
355-// plain strings so the tenant-scoped existence check that defends
356-// the boundary cannot be bypassed by a zero value.
357-type ListServiceDomainsInput struct {
358-	OrganizationID string
359-	ServiceID      string
360-}
361-
362-// ServiceDomains is the typed response of ServiceDomainReader.ListDomains:
363-// the service id the domains belong to (echoed back so a caller can
364-// distinguish a multi-resource batch in a future domains-stream
365-// endpoint even though today's GET addresses exactly one service) and
366-// the domains themselves in deterministic order. An empty Domains
367-// slice with a populated ServiceID means the service exists, is owned
368-// by the tenant, and has no domain rows — never disguised as a
369-// NotFound.
370-type ServiceDomains struct {
371-	ServiceID string
372-	Domains   []ServiceDomain
373-}
374-
375-// ListDomains returns the domain rows for the service identified by
376-// (organizationID, serviceID), reading them inside a short-lived
377-// read-only transaction. The read is tenant scoped at both legs: it
378-// Gets the service first so a cross-tenant or unknown service_id
379-// surfaces as a deterministic apierr.NotFound — never as an empty
380-// list, which would invite an agent to believe the service exists
381-// with no domains. A live service with no domains is then a
382-// deterministic empty slice. A datastore failure is propagated as
383-// its own typed error.
384-func (r *ServiceDomainReader) ListDomains(ctx context.Context, in ListServiceDomainsInput) (ServiceDomains, error) {
385-	var svcID string
386-	var domains []ServiceDomain
387-	err := r.store.Read(ctx, func(ctx context.Context, q Querier) error {
388-		svc, getErr := r.services.GetByID(ctx, q, in.OrganizationID, in.ServiceID)
389-		if getErr != nil {
390-			return getErr
391-		}
392-		svcID = svc.ID
393-		list, listErr := r.domains.ListByService(ctx, q, in.OrganizationID, in.ServiceID)
394-		if listErr != nil {
395-			return listErr
396-		}
397-		domains = list
398-		return nil
399-	})
400-	if err != nil {
401-		return ServiceDomains{}, err
402-	}
403-	return ServiceDomains{ServiceID: svcID, Domains: domains}, nil
404-}
405-
406-// serviceDomainCreateAction is the immutable audit-event Action string
407-// emitted when a service domain is created. The constant lives in the
408-// store layer because the audit event is written from the same *Tx as
409-// the desired-state row.

