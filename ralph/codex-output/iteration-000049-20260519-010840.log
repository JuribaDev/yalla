+	if len(env.Data.Refs) != 1 || env.Data.Refs[0].ID != 42 || env.Data.Refs[0].DokployID != "dkp-project-42" {
+		t.Fatalf("refs = %+v, want seeded ref", env.Data.Refs)
+	}
