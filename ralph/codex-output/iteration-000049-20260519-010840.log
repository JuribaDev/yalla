+	if op.RequiredAction != string(policy.ActionAdminRead) {
+		t.Errorf("required action = %q, want %q", op.RequiredAction, policy.ActionAdminRead)
+	}
+	if len(op.Security) == 0 {
+		t.Error("security is empty, want ApiKeyAuth requirement")
+	}
+}
