+	h.ServeHTTP(rec, req)
+	if rec.Code != http.StatusUnauthorized {
+		t.Fatalf("status = %d, want 401; body %s", rec.Code, rec.Body.String())
+	}
+	decodeError(t, rec, "E_AUTHENTICATION_REQUIRED")
+	if reader.calls != 0 {
