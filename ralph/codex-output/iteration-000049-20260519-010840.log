+func TestListAdminDokployRefsRejectsInvalidOrganizationID(t *testing.T) {
+	t.Parallel()
+
+	reader := &fakeDokployRefReader{}
+	h := adminDokployRefsHandlerFor(fakeAuthenticator{identity: auth.Identity{
