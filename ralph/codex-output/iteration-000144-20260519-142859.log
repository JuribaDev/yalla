+func (r *UsageCounterRepository) entitlementsByKey(ctx context.Context, q Querier, in AggregateUsageCountersInput) (map[string]EffectiveEntitlement, error) {
+	at := in.PeriodStart
+	if at.IsZero() {
+		at = in.AggregatedAt
+	}
