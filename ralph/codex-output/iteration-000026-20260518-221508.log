+// api_keys row.
+func (s APIKeyStatus) CanTransitionTo(next APIKeyStatus) bool {
+	allowed, ok := apiKeyTransitions[s]
+	if !ok {
+		return false
+	}
+	_, ok = allowed[next]
+	return ok
