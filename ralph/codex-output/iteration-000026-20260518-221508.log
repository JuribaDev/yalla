 }
 
 // IsRevoked reports whether the key has been explicitly revoked.
-func (k APIKey) IsRevoked() bool { return k.RevokedAt != nil }
+func (k APIKey) IsRevoked() bool { return k.Status == APIKeyStatusRevoked || k.RevokedAt != nil }
 
