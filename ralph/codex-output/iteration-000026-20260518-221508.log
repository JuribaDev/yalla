 func (k APIKey) IsExpired(now time.Time) bool {
-	return k.ExpiresAt != nil && !now.Before(*k.ExpiresAt)
+	return k.Status == APIKeyStatusExpired || (k.ExpiresAt != nil && !now.Before(*k.ExpiresAt))
 }
 
