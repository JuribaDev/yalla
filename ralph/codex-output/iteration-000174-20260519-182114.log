+		"go test ./internal/controlplane/worker/...",
+		"go test -run TestJobWorkerLease ./...",
+		"go test -run TestFakeDokploy ./...",
+		"go test ./internal/controlplane/store/...",
+		"go test ./...",
+		"go test -race ./...",
+		"go vet ./...",
+		"scripts/verify.sh",
