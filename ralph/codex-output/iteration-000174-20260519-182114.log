+		"idempotency",
+		"audit",
+		"quota",
+		"request_id",
+		"dokploy_refs",
+	} {
+		if !strings.Contains(doc, want) {
+			t.Fatalf("%s missing %q", workerJobAuthoringPath, want)
+		}
+	}
+	for _, forbidden := range []string{
+		"postgres://",
