+	OveragePolicyMode  *string
+	OverageDecision    *string
+	IncludedQuantity   *float64
+	OverageQuantity    *float64
+	CreatedAt          time.Time
+}
+
+// CloseInvoiceSnapshotInput identifies the billing period to close.
