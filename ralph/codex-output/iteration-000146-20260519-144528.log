+	AggregationVersion int
+	RequestID          string
+	CorrelationID      string
+}
+
+// ReopenInvoiceSnapshotInput records an audited administrative correction.
+type ReopenInvoiceSnapshotInput struct {
+	OrganizationID string
+	SnapshotID     string
+	ActorID        string
+	ActorKind      string
+	Reason         string
+	ReopenedAt     time.Time
+	RequestID      string
+	CorrelationID  string
+}
