diff --git a/internal/controlplane/store/invoice_snapshot_repository_test.go b/internal/controlplane/store/invoice_snapshot_repository_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..f165c3a3cf2703b18ae3d94f86785139f5f8edbc
