+		Resource:       store.QuotaResourceBuildMinutes,
+		EventType:      store.UsageEventTypeConsumed,
+		Quantity:       2,
+		Unit:           "minute",
+		Source:         "yalla_jobs",
+		IdempotencyKey: "invoice-closed-late",
