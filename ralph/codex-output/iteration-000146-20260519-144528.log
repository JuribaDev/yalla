+		PeriodStart:        periodStart,
+		PeriodEnd:          periodEnd,
+		AggregatedAt:       periodEnd.Add(time.Hour),
+		AggregationVersion: 1,
+	})
+	closeInvoiceSnapshotOrFail(ctx, t, s, invoices, store.CloseInvoiceSnapshotInput{
