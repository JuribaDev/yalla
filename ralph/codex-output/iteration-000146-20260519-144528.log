+	var snapshot store.InvoiceSnapshot
+	if err := s.Write(ctx, func(ctx context.Context, tx *store.Tx) error {
+		var err error
+		snapshot, err = repo.ReopenForCorrection(ctx, tx, in)
+		return err
+	}); err != nil {
+		t.Fatalf("Reopen invoice snapshot: %v", err)
+	}
+	return snapshot
+}
