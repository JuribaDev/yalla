	out := make([]EffectiveEntitlement, 0)
	for rows.Next() {
		var ent EffectiveEntitlement
		if err := rows.Scan(
			&ent.EntitlementKey, &ent.LimitValue, &ent.EnforcementMode, &ent.Source,
