+		"api-key-",
+		"dokploy-service-token",
+		"cookie:",
+		"password:",
+		"YALLA_DOKPLOY_TOKEN=",
+		"YALLA_SIGNING_KEYS=",
+		"YALLA_SECRET_KEYS=",
