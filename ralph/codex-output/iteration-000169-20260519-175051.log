+		want []string
+	}{
+		{
+			path: "scripts/verify.sh",
+			want: []string{
+				"go test ./internal/release/... -run TestDatabaseMigrationAuthoringArtifact",
+			},
+		},
+		{
+			path: ".github/workflows/ci.yml",
+			want: []string{
+				"Database migration authoring artifact static tests",
+				"go test ./internal/release/... -run TestDatabaseMigrationAuthoringArtifact",
+			},
+		},
+		{
+			path: "SECURITY.md",
