+		"go test -run TestMigrationsDowngradeSafety ./...",
+		"go test ./internal/controlplane/store/...",
+		"go test ./...",
+		"go test -race ./...",
+		"go vet ./...",
+		"scripts/verify.sh",
+	} {
+		if !strings.Contains(doc, want) {
+			t.Fatalf("%s missing %q", databaseMigrationAuthoringPath, want)
+		}
+	}
+}
