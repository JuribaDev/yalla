+		"password:",
+		"YALLA_DOKPLOY_TOKEN=",
+		"YALLA_SIGNING_KEYS=",
+		"YALLA_SECRET_KEYS=",
+	} {
+		if strings.Contains(strings.ToLower(doc), strings.ToLower(forbidden)) {
+			t.Fatalf("%s must not contain rendered secret-looking value %q", databaseMigrationAuthoringPath, forbidden)
+		}
+	}
+}
